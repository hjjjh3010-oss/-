                    "button_label": "",
                    "button_url": "",
                    "button_text_color": "",
                    "button_background_color": "",
                    "button_border_color": "",
                    "content": "<p>Turn simple gift cards into cherished holiday keepsakes with this beautifully crafted, lay-flat album. It adds a personal, memorable touch to your gift-giving experience.</p><ul><li>Premium spiral-bound design for easy viewing</li><li>High-quality paper and thick cardstock feel luxurious</li><li>Holiday-themed pages enhance personalization</li><li> Compact 5x7 size fits stockings or hand-delivery</li></ul>",
                    "collapsible_font_heading_size": 16,
                    "collapsible_font_size": 12,
                    "coll_heading_color": "#000000",
                    "coll_heading_highlighted_color": "#000000",
