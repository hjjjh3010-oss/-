<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg }}">

  {% if settings.favicon %}
    <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}" sizes="32x32">
  {% endif %}
  {% if settings.apple_touch_icon %}
    <link rel="apple-touch-icon" href="{{ settings.apple_touch_icon | image_url: width: 180 }}">
  {% endif %}

  {{ content_for_header }}

  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
</head>
<body class="password-page">
  <main class="password-main">
    <div class="password-container">
      {% if settings.logo_image %}
        <img src="{{ settings.logo_image | image_url: width: 200 }}" alt="{{ shop.name }}" class="password-logo" width="{{ settings.logo_width }}" height="auto">
      {% else %}
        <h1 class="password-logo-text">{{ settings.logo_text }}</h1>
      {% endif %}

      <h2 class="password-heading">{{ 'password_page.heading' | t }}</h2>

      <p class="password-message">{{ shop.password_message }}</p>

      {% if shop.password_page_show_email_form %}
        <form action="{{ routes.root_url }}" method="post" class="password-form">
          <input type="hidden" name="form_type" value="customer_password">
          <input type="hidden" name="utf8" value="✓">
          <div class="field">
            <label for="password_email" class="field__label visually-hidden">{{ 'password_page.email_placeholder' | t }}</label>
            <input type="email" name="email" id="password_email" class="field__input" placeholder="{{ 'password_page.email_placeholder' | t }}" required autocomplete="email">
          </div>
          <button type="submit" class="btn btn--primary">{{ 'password_page.submit' | t }}</button>
        </form>
      {% endif %}

      {% if shop.password_page_show_social %}
        <div class="password-social">
          {% render 'social-icons' %}
        </div>
      {% endif %}
    </div>
  </main>

  <footer class="password-footer">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </footer>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>