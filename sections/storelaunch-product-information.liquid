                    --sl-vp-dropdown-text: {{ block.settings.dropdown_text_color }};
                    --sl-vp-btn-bg: {{ block.settings.button_background }};
                    --sl-vp-btn-text: {{ block.settings.button_text_color }};
                    --sl-vp-btn-selected-bg: {{ block.settings.button_selected_background }};
                    --sl-vp-btn-selected-text: {{ block.settings.button_selected_text_color }};
