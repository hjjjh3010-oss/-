                      {% endfor %}
                    </select>
                    </div>
                  {% elsif vp_style == 'dropdown' %}
                    <input type="hidden" name="id" value="{{ selected_variant.id }}" data-sl-variant-id>
                    <div class="sl-pi__variant-options">
                      {% for option in product.options_with_values %}
                        <div class="sl-pi__option-group">
                          {% if vp_show_labels %}
                            <label class="sl-pi__label" for="option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label>
                          {% endif %}
                          <div class="sl-pi__select-wrap">
                            <select
                              id="option-{{ section.id }}-{{ forloop.index0 }}"
                              class="sl-pi__select"
                              data-sl-option-select
                              data-option-index="{{ forloop.index0 }}"
                              {% unless vp_show_labels %}aria-label="{{ option.name | escape }}"{% endunless %}
                            >
                              {% for value in option.values %}
                                <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                              {% endfor %}
                            </select>
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  {% else %}
                    <input type="hidden" name="id" value="{{ selected_variant.id }}" data-sl-variant-id>
                    <div class="sl-pi__variant-options">
                      {% for option in product.options_with_values %}
