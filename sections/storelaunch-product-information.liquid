                  {% endif %}
                </ul>
              </div>

            {% when 'benefits' %}
              {% assign ben_id = block.id | handleize | default: section.id %}
              <div class="sl-ben sl-ben--{{ ben_id }}" style="
                --ben-gap: {{ block.settings.row_gap | default: '10' }}px;
                --ben-icon: {{ block.settings.icon_color | default: '#16a34a' }};
                --ben-text: {{ block.settings.text_color | default: '#171717' }};
                font-size: {{ block.settings.font_size | default: '14' }}px;
                margin-top: {{ block.settings.wrapper_margin_top | default: 8 }}px;
                margin-bottom: {{ block.settings.wrapper_margin_bottom | default: 8 }}px;
              " {{ block.shopify_attributes }}>
                <style>
                  .sl-ben--{{ ben_id }} .sl-ben__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ben-gap); width: fit-content; max-width: 100%; margin-inline: 0; }
                  .sl-ben--{{ ben_id }} .sl-ben__row { display: grid; grid-template-columns: 1.15em minmax(0, 1fr); column-gap: 0.55em; align-items: start; }
                  .sl-ben--{{ ben_id }} .sl-ben__check { width: 1.15em; height: 1.15em; color: var(--ben-icon); margin-top: 0.14em; justify-self: start; }
                  .sl-ben--{{ ben_id }} .sl-ben__text { color: var(--ben-text); line-height: 1.45; margin: 0; }
                </style>
                <ul class="sl-ben__list" role="list">
                  <li class="sl-ben__row">
                    <svg class="sl-ben__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    <p class="sl-ben__text">{{ block.settings.benefit_1 | default: 'Free shipping on orders over $50' }}</p>
                  </li>
                  <li class="sl-ben__row">
                    <svg class="sl-ben__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    <p class="sl-ben__text">{{ block.settings.benefit_2 | default: '30-day hassle-free returns' }}</p>
                  </li>
                  <li class="sl-ben__row">
                    <svg class="sl-ben__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    <p class="sl-ben__text">{{ block.settings.benefit_3 | default: 'Secure checkout & buyer protection' }}</p>
                  </li>
                </ul>
              </div>

            {% when 'benefits_with_icons' %}
              {% assign bwi_id = block.id | handleize | default: section.id %}
              <div
                class="sl-bwi sl-bwi--{{ bwi_id }}"
                style="
                  --bwi-gap: {{ block.settings.row_gap | default: 10 }}px;
                  --bwi-icon: {{ block.settings.icon_color | default: '#16a34a' }};
                  --bwi-text: {{ block.settings.text_color | default: '#171717' }};
                  font-size: {{ block.settings.font_size | default: 14 }}px;
                  margin-top: {{ block.settings.wrapper_margin_top | default: 8 }}px;
                  margin-bottom: {{ block.settings.wrapper_margin_bottom | default: 8 }}px;
                "
                {{ block.shopify_attributes }}
              >
                <style>
                  .sl-bwi--{{ bwi_id }} .sl-bwi__list {
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    display: grid;
                    gap: var(--bwi-gap);
                    width: fit-content;
                    max-width: 100%;
                    margin-inline: 0;
                  }
                  .sl-bwi--{{ bwi_id }} .sl-bwi__row {
                    display: grid;
                    grid-template-columns: 1.2em minmax(0, 1fr);
                    column-gap: 0.55em;
                    align-items: start;
                  }
                  .sl-bwi--{{ bwi_id }} .sl-bwi__icon {
                    width: 1.2em;
                    height: 1.2em;
                    color: var(--bwi-icon);
                    margin-top: 0.12em;
                    justify-self: start;
                    line-height: 1;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                  }
                  .sl-bwi--{{ bwi_id }} .sl-bwi__icon i {
                    font-size: 1em;
                    line-height: 1;
                  }
                  .sl-bwi--{{ bwi_id }} .sl-bwi__text {
                    color: var(--bwi-text);
                    line-height: 1.45;
                    margin: 0;
                  }
                </style>
                <ul class="sl-bwi__list" role="list">
                  {% if block.settings.benefit_1 != blank %}
                    <li class="sl-bwi__row">
                      <span class="sl-bwi__icon" aria-hidden="true"><i class="ph ph-{{ block.settings.icon_1 | default: 'heart' }}"></i></span>
                      <p class="sl-bwi__text">{{ block.settings.benefit_1 }}</p>
                    </li>
                  {% endif %}
                  {% if block.settings.benefit_2 != blank %}
                    <li class="sl-bwi__row">
                      <span class="sl-bwi__icon" aria-hidden="true"><i class="ph ph-{{ block.settings.icon_2 | default: 'shield-check' }}"></i></span>
                      <p class="sl-bwi__text">{{ block.settings.benefit_2 }}</p>
                    </li>
                  {% endif %}
                  {% if block.settings.benefit_3 != blank %}
                    <li class="sl-bwi__row">
                      <span class="sl-bwi__icon" aria-hidden="true"><i class="ph ph-{{ block.settings.icon_3 | default: 'rocket-launch' }}"></i></span>
                      <p class="sl-bwi__text">{{ block.settings.benefit_3 }}</p>
                    </li>
                  {% endif %}
                </ul>
              </div>

            {% when 'benefits_grid' %}
              {% assign benefits2_id = block.id | handleize | default: section.id %}
              <div
                class="benefits-2-root benefits-2-root--{{ benefits2_id }}"
                data-block-type="benefits-2"
                style="
                  --benefits-2-font-size-desktop: {{ block.settings.font_size_desktop | default: 12 }}px;
                  --benefits-2-font-size-mobile: {{ block.settings.font_size_mobile | default: 12 }}px;
                  --benefits-2-text-color: {{ block.settings.text_color | default: '#000000' }};
                  --benefits-2-checkmark-bg-color: {{ block.settings.checkmark_bg_color | default: '#000000' }};
                  --benefits-2-checkmark-color: {{ block.settings.checkmark_color | default: '#FFFFFF' }};
                  --benefits-2-border-color: {{ block.settings.border_color | default: '#000000' }};
                  --benefits-2-border-style: {{ block.settings.border_style | default: 'dashed' }};
                  --benefits-2-border-width: {{ block.settings.border_width | default: 1 }}px;
                  --benefits-2-border-radius: {{ block.settings.border_radius | default: 20 }}px;
                  --benefits-2-gap: {{ block.settings.gap | default: 10 }}px;
                  --benefits-2-margin-top: {{ block.settings.margin_top | default: 0 }}px;
                  --benefits-2-margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;
                "
                {{ block.shopify_attributes }}
              >
                <style>
                  .benefits-2-root--{{ benefits2_id }} .benefits-2-container {
                    width: 100%;
                    margin-top: var(--benefits-2-margin-top);
                    margin-bottom: var(--benefits-2-margin-bottom);
                  }
                  .benefits-2-root--{{ benefits2_id }} .benefits-2-grid {
                    display: grid;
                    grid-template-columns: repeat(4, minmax(0, 1fr));
                    gap: var(--benefits-2-gap);
                    width: 100%;
                    justify-content: stretch;
                    align-items: start;
                  }
                  .benefits-2-root--{{ benefits2_id }} .benefit-2-item {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    justify-content: flex-start;
                    text-align: center;
                    padding: 8px 4px;
                    border: var(--benefits-2-border-width) var(--benefits-2-border-style) var(--benefits-2-border-color);
                    border-radius: var(--benefits-2-border-radius);
                    background: transparent;
                    gap: 6px;
                    width: 100%;
                    max-width: 100%;
                    min-width: 0;
                    box-sizing: border-box;
                  }
                  .benefits-2-root--{{ benefits2_id }} .benefit-2-icon {
                    width: 20px;
                    height: 20px;
                    border-radius: 50%;
                    background-color: var(--benefits-2-checkmark-bg-color);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                  }
                  .benefits-2-root--{{ benefits2_id }} .benefit-2-icon .checkmark-svg {
                    width: 12px;
                    height: 12px;
                    color: var(--benefits-2-checkmark-color);
                    fill: var(--benefits-2-checkmark-color);
                  }
                  .benefits-2-root--{{ benefits2_id }} .benefit-2-text {
                    font-size: var(--benefits-2-font-size-desktop);
                    color: var(--benefits-2-text-color);
                    line-height: 1.4;
                    font-weight: 400;
                    margin: 0;
                    white-space: normal;
                    overflow-wrap: anywhere;
                  }
                  @media screen and (max-width: 768px) {
                    .benefits-2-root--{{ benefits2_id }} .benefits-2-grid {
                      grid-template-columns: repeat(4, minmax(0, 1fr));
                      gap: 6px;
                    }
                    .benefits-2-root--{{ benefits2_id }} .benefit-2-item {
                      width: 100%;
                      max-width: 100%;
                    }
                    .benefits-2-root--{{ benefits2_id }} .benefit-2-icon {
                      width: 18px;
                      height: 18px;
                    }
                    .benefits-2-root--{{ benefits2_id }} .benefit-2-icon .checkmark-svg {
