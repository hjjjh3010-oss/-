                  .sl-infobox--{{ info_id }} .sl-infobox__text {
                    margin: 0;
                    color: var(--infobox-text);
                    font-size: var(--infobox-text-size);
                    line-height: 1.45;
                  }
                </style>
                <div class="sl-infobox__inner">
                  <p class="sl-infobox__title">{{ block.settings.title | default: 'Order updates' }}</p>
                  <p class="sl-infobox__text">{{ block.settings.body | default: "You'll get an email when your order ships. Tracking is added automatically-you can also check status in your account at any time." }}</p>
                </div>
              </div>

            {% when 'shipping_eta' %}
              {% if block.settings.show %}
                {% assign ship_date_locale = block.settings.date_locale | strip %}
                {% if ship_date_locale == blank %}
                  {% assign ship_date_locale = request.locale.iso_code | default: 'en' %}
                {% endif %}
                <div
                  class="sl-pi2__ship"
                  data-sl-ship-root
                  data-locale="{{ ship_date_locale | escape }}"
                  data-transit-min="{{ block.settings.transit_min | default: 3 }}"
                  data-transit-max="{{ block.settings.transit_max | default: 6 }}"
                  style="
                    --ship-muted: {{ block.settings.muted_color | default: '#525252' }};
                    --ship-fg: {{ block.settings.text_color | default: '#171717' }};
                    font-size: {{ block.settings.font_size | default: 14 }}px;
                    margin-top: {{ block.settings.margin_top | default: 14 }}px;
                  "
                  {{ block.shopify_attributes }}
                >
                  <style>
                    .sl-pi2__ship[data-sl-ship-root] .sl-pi2__ship-text {
                      margin: 0;
                      color: var(--ship-muted);
                      line-height: 1.45;
                    }
                    .sl-pi2__ship[data-sl-ship-root] .sl-pi2__ship-lead {
                      color: var(--ship-fg);
                      margin-inline-end: 0.3em;
                    }
                    .sl-pi2__ship[data-sl-ship-root] .sl-pi2__ship-date {
                      color: var(--ship-fg);
                      font-weight: 600;
                    }
                  </style>
                  <p class="sl-pi2__ship-text">
                    <span class="sl-pi2__ship-lead">{{ block.settings.line_lead | default: 'Get your order on' }}</span>
                    <span class="sl-pi2__ship-date" data-sl-ship-date></span>
                  </p>
                  <script>
                    (function () {
                      var root = document.currentScript && document.currentScript.closest('[data-sl-ship-root]');
                      if (!root) return;
                      var dateTarget = root.querySelector('[data-sl-ship-date]');
                      if (!dateTarget) return;
                      var locale = root.getAttribute('data-locale') || 'en';
                      var minTransit = parseInt(root.getAttribute('data-transit-min'), 10) || 3;
                      var maxTransit = parseInt(root.getAttribute('data-transit-max'), 10) || 6;
                      if (maxTransit < minTransit) maxTransit = minTransit;
                      var today = new Date();
                      var range = maxTransit - minTransit + 1;
                      var offset = minTransit + Math.floor(Math.random() * range);
                      var eta = new Date(today.getFullYear(), today.getMonth(), today.getDate() + offset);
                      var formatted = '';
                      try {
                        formatted = new Intl.DateTimeFormat(locale, { month: 'long', day: 'numeric' }).format(eta);
                      } catch (e) {
                        formatted = eta.toLocaleDateString(undefined, { month: 'long', day: 'numeric' });
                      }
                      dateTarget.textContent = formatted;
                    })();
                  </script>
                </div>
              {% endif %}

            {% when 'trust_container' %}
              {% if block.settings.show %}
                <div class="sl-pi2__trust-block">
                  <div
                    class="sl-pi2__trust"
                    style="
                      --trust-bg: {{ block.settings.bg_color | default: '#FFFFFF' }};
                      --trust-border: {{ block.settings.border_color | default: '#e8e8ec' }};
                      --trust-text: {{ block.settings.text_color | default: '#0a0a0a' }};
                      --trust-rating: {{ block.settings.rating_color | default: '#0a0a0a' }};
                      --trust-divider: {{ block.settings.divider_color | default: '#e8e8ec' }};
                      --trust-star: {{ block.settings.star_color | default: '#000000' }};
                      --trust-star-size: {{ block.settings.star_size | default: 16 }}px;
                      --trust-star-gap: {{ block.settings.star_gap | default: 8 }}px;
                      margin-top: {{ block.settings.margin_top | default: 12 }}px;
                      margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;
                      padding: {{ block.settings.padding | default: 18 }}px;
                      border-radius: {{ block.settings.border_radius | default: 12 }}px;
                      font-size: {{ block.settings.font_size | default: 14 }}px;
                    "
                    {{ block.shopify_attributes }}
                  >
                    <style>
                      .sl-pi2__trust {
                        background: var(--trust-bg);
                        border: 1px solid var(--trust-border);
                        color: var(--trust-text);
                      }
                      .sl-pi2__trust-score {
                        display: flex;
                        align-items: center;
                        justify-content: flex-start;
                        gap: 10px;
                        flex-wrap: wrap;
                      }
                      .sl-pi2__trust-stars {
                        display: flex;
                        align-items: center;
                        flex-shrink: 0;
                        gap: 2px;
                      }
                      .sl-pi2__trust-stars img {
                        height: var(--trust-star-size);
                        width: auto;
                        display: block;
                      }
                      .sl-pi2__trust-star-svg {
                        width: var(--trust-star-size);
                        height: var(--trust-star-size);
                        flex-shrink: 0;
                        display: block;
                        fill: var(--trust-star);
                      }
                      .sl-pi2__trust-meta {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        line-height: 1.2;
                        flex-wrap: wrap;
                        color: var(--trust-rating);
                      }
                      .sl-pi2__trust-sep {
                        color: color-mix(in srgb, var(--trust-rating) 40%, #ffffff);
                      }
                      .sl-pi2__trust hr {
                        border: 0;
                        border-top: 1px solid var(--trust-divider);
                        margin: 12px 0;
                      }
                      .sl-pi2__trust p {
                        margin: 0;
                        line-height: 1.45;
                      }
                      .sl-pi2__payment-icons {
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        flex-wrap: wrap;
                      }
                      .sl-pi2__payment-icon {
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                      }
                    </style>
                    <div class="sl-pi2__trust-score">
                      <div class="sl-pi2__trust-stars" aria-hidden="true">
                        {% assign trust_icon_style = block.settings.rating_icon_style | default: 'trustpilot' %}
                        {% if trust_icon_style == 'trustpilot' %}
                          <img
                            src="{% if block.settings.badge_image != blank %}{{ block.settings.badge_image }}{% else %}https://i.imgur.com/EHjNmTM.png{% endif %}"
                            alt=""
                            loading="lazy"
                            width="100"
                            height="20"
                          >
                        {% else %}
                          {% for i in (1..5) %}
                            <svg class="sl-pi2__trust-star-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12.0006 18.26L4.94715 22.2082L6.52248 14.2799L0.587891 8.7918L8.61493 7.84006L12.0006 0.5L15.3862 7.84006L23.4132 8.7918L17.4787 14.2799L19.054 22.2082L12.0006 18.26Z"/></svg>
                          {% endfor %}
                        {% endif %}
                      </div>
                      <div class="sl-pi2__trust-meta">
                        <strong>{{ block.settings.rating | default: '4.8' }}</strong>
                        <span class="sl-pi2__trust-sep">|</span>
                        <span>
                          {% if block.settings.review_count != blank %}
                            <strong>{{ block.settings.review_count }}</strong> {{ block.settings.reviews_label | default: 'reviews' }}
                          {% else %}
                            {{ block.settings.reviews_label | default: '1,322 verified reviews' }}
                          {% endif %}
                        </span>
                      </div>
                    </div>
                    <hr>
                    <p><strong>{{ block.settings.delivery_title | default: 'Free delivery' }}</strong> {{ block.settings.delivery_body | default: 'on orders over $50' }}</p>
                    <hr>
                    <p><strong>{{ block.settings.guarantee_title | default: '30-day guarantee' }}</strong> {{ block.settings.guarantee_body | default: '— full refund, no hassle' }}</p>
                    <hr>
                    <div class="sl-pi2__payment-icons">
                      <span class="sl-pi2__payment-icon"><img src="https://raw.githubusercontent.com/activemerchant/payment_icons/master/app/assets/images/payment_icons/visa.svg" alt="" width="32" height="20" loading="lazy"></span>
                      <span class="sl-pi2__payment-icon"><img src="https://raw.githubusercontent.com/activemerchant/payment_icons/master/app/assets/images/payment_icons/master.svg" alt="" width="32" height="20" loading="lazy"></span>
                      <span class="sl-pi2__payment-icon"><img src="https://raw.githubusercontent.com/activemerchant/payment_icons/master/app/assets/images/payment_icons/american_express.svg" alt="" width="32" height="20" loading="lazy"></span>
                      <span class="sl-pi2__payment-icon"><img src="https://raw.githubusercontent.com/activemerchant/payment_icons/master/app/assets/images/payment_icons/paypal.svg" alt="" width="32" height="20" loading="lazy"></span>
                    </div>
                  </div>
                </div>
              {% endif %}

            {% when 'collapsible_row' %}
              {%- liquid
                assign cr_title = block.settings.title
                assign cr_content = block.settings.content
                assign cr_title_down = cr_title | downcase | strip
                if cr_content == blank
                  if cr_title_down == 'how it works' or cr_title_down == 'how to use' or cr_title_down == 'how to use it'
                    assign cr_content = product.description
                  endif
                endif
                assign cr_icon = 'info'
                if cr_title_down contains 'work'
                  assign cr_icon = 'works'
                elsif cr_title_down contains 'use'
                  assign cr_icon = 'use'
                elsif cr_title_down contains 'ship'
                  assign cr_icon = 'ship'
                elsif cr_title_down contains 'return' or cr_title_down contains 'refund'
                  assign cr_icon = 'return'
                endif
              -%}
              <div class="sl-pi__accordion sl-pi__accordion--clean" {{ block.shopify_attributes }}>
                {% if cr_title != blank %}
                  <details>
                    <summary>
                      <span class="sl-pi__accordion-label" style="display:inline-flex; align-items:center; gap:10px;">
                        {% if s.show_collapsible_icons %}
                        <span class="sl-pi__accordion-ico" aria-hidden="true" style="display:inline-flex; width:18px; height:18px; color: var(--sl-accent);">
                          {% case cr_icon %}
                            {% when 'works' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.36.16.66.43.86.77.2.34.3.73.3 1.13V11a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                            {% when 'use' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                            {% when 'ship' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                            {% when 'return' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                            {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                          {% endcase %}
                        </span>
                        {% endif %}
                        <span>{{ cr_title | escape }}</span>
                      </span>
                      <span class="sl-pi__accordion-icon"></span>
                    </summary>
                    <div class="sl-pi__accordion-content rte">{{ cr_content }}</div>
                  </details>
                {% endif %}
              </div>

            {% when '@app' %}
              <div {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {% when 'custom_liquid' %}
              <div {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>
          {% endcase %}
        {% endfor %}
      {% endform %}
      {% else %}
        <div class="sl-pi__desc rte">
          <p>Select a product for this section to enable product information and add to cart.</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% if product and selected_variant %}
  <div class="sl-pi__sticky" data-sl-sticky aria-hidden="true">
    <div class="sl-pi__sticky-inner">
      <div class="sl-pi__sticky-info">
        <span class="sl-pi__sticky-title">{{ product.title | truncatewords: 5 }}</span>
        <span class="sl-pi__sticky-price">
          <span data-sl-sticky-price>{{ selected_variant.price | money }}</span>
          {% if selected_variant.compare_at_price > selected_variant.price %}
            <s class="sl-pi__sticky-compare">{{ selected_variant.compare_at_price | money }}</s>
          {% endif %}
        </span>
      </div>
      <button type="button" class="sl-pi__sticky-btn" data-sl-sticky-btn style="background: var(--sl-accent); color: #ffffff;">
        {{ s.add_to_cart_label | default: 'Add to cart' | escape }}
      </button>
    </div>
  </div>
{% endif %}

<script>
  (function() {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    // --- Sticky mobile add-to-cart bar ---
    var sticky = root.querySelector('[data-sl-sticky]');
    var mainCta = root.querySelector('.sl-pi__cta');
    if (sticky && mainCta) {
      var stickyBtn = sticky.querySelector('[data-sl-sticky-btn]');
      if (stickyBtn) {
        stickyBtn.addEventListener('click', function () { mainCta.click(); });
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { sticky.classList.remove('is-visible'); sticky.setAttribute('aria-hidden', 'true'); }
            else { sticky.classList.add('is-visible'); sticky.setAttribute('aria-hidden', 'false'); }
          });
        }, { threshold: 0 });
        io.observe(mainCta);
      }
      // keep sticky price in sync with the buy-box price
      var srcPrice = root.querySelector('.sl-pi__price > span:first-child');
      var dstPrice = sticky.querySelector('[data-sl-sticky-price]');
      if (srcPrice && dstPrice) {
        var syncPrice = function () { dstPrice.textContent = srcPrice.textContent; };
        new MutationObserver(syncPrice).observe(srcPrice, { characterData: true, childList: true, subtree: true });
      }
    }

    var revealStarBadges = function () {
      var badges = root.querySelectorAll('.kodu-star-badge-wrapper[data-sl-pi-star]');
      badges.forEach(function (badge) {
        badge.classList.add('is-ready');
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', revealStarBadges, { once: true });
    } else {
      revealStarBadges();
    }

    var variantPicker = root.querySelector('[data-sl-variant-picker]');
    if (variantPicker) {
      var variantsDataEl = variantPicker.querySelector('[data-sl-variants-data]');
      var variants = [];
      try {
        variants = JSON.parse(variantsDataEl && variantsDataEl.textContent || '[]');
      } catch (err) {
        variants = [];
      }

      var mainImg = root.querySelector('.sl-pi__main-img');
      var thumbs = root.querySelectorAll('[data-sl-pi-thumb]');
      var priceEl = root.querySelector('.sl-pi__price > span:first-child');
      var compareEl = root.querySelector('.sl-pi__price-compare');
      var idInput = variantPicker.querySelector('[name="id"]');
      var combinedSelect = variantPicker.querySelector('[data-sl-variant-select]');
      var optionSelects = variantPicker.querySelectorAll('[data-sl-option-select]');
      var optionBtns = variantPicker.querySelectorAll('[data-sl-option-btn]');
      function getSelectedOptions() {
        if (combinedSelect) return null;
        var count = optionSelects.length || (optionBtns.length ? Math.max.apply(null, Array.prototype.map.call(optionBtns, function(btn) {
          return parseInt(btn.getAttribute('data-option-index'), 10) + 1;
        })) : 0);
        var options = new Array(count);
        optionSelects.forEach(function(sel) {
          var idx = parseInt(sel.getAttribute('data-option-index'), 10);
          options[idx] = sel.value;
        });
        optionBtns.forEach(function(btn) {
          if (!btn.classList.contains('is-selected')) return;
          var idx = parseInt(btn.getAttribute('data-option-index'), 10);
          options[idx] = btn.getAttribute('data-option-value');
        });
        return options;
      }

      function findVariant() {
        if (combinedSelect) {
          var id = parseInt(combinedSelect.value, 10);
          return variants.find(function(v) { return v.id === id; }) || null;
        }
        var options = getSelectedOptions();
        if (!options || !options.length) return null;
        return variants.find(function(v) {
          if (!v.options || v.options.length < options.length) return false;
          for (var i = 0; i < options.length; i++) {
            if (v.options[i] !== options[i]) return false;
          }
          return true;
        }) || null;
      }

      function setMainImage(variant) {
        if (!mainImg || !variant || !variant.featured_image_src) return;
        mainImg.loading = 'eager';
        mainImg.removeAttribute('srcset');
        mainImg.removeAttribute('sizes');
        mainImg.src = variant.featured_image_src;
        mainImg.alt = variant.featured_image_alt || mainImg.alt || '';
        if (thumbs.length) {
          thumbs.forEach(function(thumb) {
            var mediaId = thumb.getAttribute('data-media-id');
            var isMatch = mediaId && variant.featured_media_id && String(mediaId) === String(variant.featured_media_id);
            thumb.classList.toggle('sl-pi__thumb-item--featured', isMatch);
          });
        }
      }

      function updateAvailability() {
        if (combinedSelect || !variants.length) return;
        var selected = getSelectedOptions();
        if (!selected) return;
        optionBtns.forEach(function(btn) {
          var idx = parseInt(btn.getAttribute('data-option-index'), 10);
          var value = btn.getAttribute('data-option-value');
          var testOptions = selected.slice();
          testOptions[idx] = value;
          var match = variants.find(function(v) {
            if (!v.options) return false;
            for (var i = 0; i < testOptions.length; i++) {
              if (v.options[i] !== testOptions[i]) return false;
            }
            return true;
          });
          btn.classList.toggle('is-unavailable', !match || !match.available);
          btn.disabled = !match || !match.available;
        });
      }

      function applyVariant(variant) {
        if (!variant) return;
        if (idInput) idInput.value = variant.id;
        if (combinedSelect) combinedSelect.value = String(variant.id);
        if (priceEl) priceEl.textContent = variant.price_formatted || priceEl.textContent;
        if (compareEl) {
          if (variant.compare_at_price && variant.price && variant.compare_at_price > variant.price) {
            compareEl.textContent = variant.compare_at_price_formatted;
            compareEl.style.display = '';
          } else {
            compareEl.style.display = 'none';
          }
        }
        setMainImage(variant);
        updateAvailability();
      }

      function onVariantChange() {
        var variant = findVariant();
        if (variant) applyVariant(variant);
      }

      if (combinedSelect) {
        combinedSelect.addEventListener('change', onVariantChange);
      }
      optionSelects.forEach(function(sel) {
        sel.addEventListener('change', onVariantChange);
      });
      optionBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (btn.disabled) return;
          var idx = btn.getAttribute('data-option-index');
          variantPicker.querySelectorAll('[data-sl-option-btn][data-option-index="' + idx + '"]').forEach(function(other) {
            other.classList.remove('is-selected');
          });
          btn.classList.add('is-selected');
          onVariantChange();
        });
      });

      updateAvailability();
    }

    var galleryMainImg = root.querySelector('.sl-pi__main-img');
    var galleryGrid = root.querySelector('.sl-pi__thumb-grid');
    if (galleryMainImg && galleryGrid && !galleryGrid.dataset.slGalleryBound) {
      galleryGrid.dataset.slGalleryBound = '1';

      function slGalleryActivate(thumb) {
        if (!thumb) return;
        var nextUrl = thumb.getAttribute('data-full-src');
        if (!nextUrl) return;
        var nextAlt = thumb.getAttribute('data-alt') || galleryMainImg.alt || '';

        // Mark active immediately so UI feels responsive even if same URL
        var allThumbs = galleryGrid.querySelectorAll('[data-sl-pi-thumb]');
        allThumbs.forEach(function(t) {
          t.classList.toggle('sl-pi__thumb-item--featured', t === thumb);
        });

        // Compare resolved URLs to avoid redundant swap (and avoid flicker)
        var currentUrl = galleryMainImg.currentSrc || galleryMainImg.getAttribute('src') || '';
        var resolvedNext, resolvedCurrent;
        try { resolvedNext = new URL(nextUrl, window.location.href).href; } catch (e) { resolvedNext = nextUrl; }
        try { resolvedCurrent = new URL(currentUrl, window.location.href).href; } catch (e) { resolvedCurrent = currentUrl; }
        if (resolvedNext === resolvedCurrent) return;

        // Preload the new image, then crossfade to avoid the broken/flash state
        var pre = new Image();
        var commit = function() {
          galleryMainImg.removeAttribute('srcset');
          galleryMainImg.removeAttribute('sizes');
          galleryMainImg.loading = 'eager';
          galleryMainImg.setAttribute('src', nextUrl);
          galleryMainImg.alt = nextAlt;
          // next frame: fade back in
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              galleryMainImg.classList.remove('is-swapping');
            });
          });
        };
        galleryMainImg.classList.add('is-swapping');
        pre.onload = commit;
        pre.onerror = commit;
        pre.src = nextUrl;
      }

      // Single delegated click handler — survives nested <img> clicks and
      // avoids double-binding if the section ever re-runs its script.
      galleryGrid.addEventListener('click', function(e) {
        var thumb = e.target && e.target.closest ? e.target.closest('[data-sl-pi-thumb]') : null;
        if (!thumb || !galleryGrid.contains(thumb)) return;
        e.preventDefault();
        e.stopPropagation();
        slGalleryActivate(thumb);
      });

      // Keyboard activation for accessibility
      galleryGrid.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        var thumb = e.target && e.target.closest ? e.target.closest('[data-sl-pi-thumb]') : null;
        if (!thumb) return;
        e.preventDefault();
        slGalleryActivate(thumb);
      });
    }

    var qtyInput = root.querySelector('.sl-pi__qty');
    var minus = root.querySelector('[data-sl-pi-qty-minus]');
    var plus = root.querySelector('[data-sl-pi-qty-plus]');
    if (qtyInput && minus && plus) {
      minus.addEventListener('click', function() {
        var next = Math.max(1, (parseInt(qtyInput.value || '1', 10) || 1) - 1);
        qtyInput.value = next;
      });
      plus.addEventListener('click', function() {
        var next = (parseInt(qtyInput.value || '1', 10) || 1) + 1;
        qtyInput.value = next;
      });
    }

    var atcPriceTargets = root.querySelectorAll('[data-sl-atc-price]');
    if (atcPriceTargets.length) {
      var priceTextNode = root.querySelector('.sl-pi__price > span:first-child');
      var syncAtcPrice = function() {
        if (!priceTextNode) return;
        var text = (priceTextNode.textContent || '').trim();
        if (!text) return;
        atcPriceTargets.forEach(function(node) {
          node.textContent = text;
        });
      };
      syncAtcPrice();
      if (priceTextNode && window.MutationObserver) {
        var obs = new MutationObserver(syncAtcPrice);
        obs.observe(priceTextNode, { characterData: true, childList: true, subtree: true });
      }
    }

    function slPiUgcIsDesktop() {
      return window.matchMedia('(min-width: 750px)').matches;
    }

    /** Decode a non-black still (many MP4s show black at t=0 on mobile). */
    function slPrimeUgcVideoFrame(video) {
      if (!video || video.dataset.slUgcPrimed === '1') return;
      var go = function() {
        if (video.dataset.slUgcPrimed === '1') return;
        var wasMuted = video.muted;
        video.muted = true;
        var t = 0.06;
        try {
          if (video.duration && !isNaN(video.duration) && video.duration > 0) {
            t = Math.min(0.15, Math.max(0.04, video.duration * 0.02));
          }
          video.currentTime = t;
        } catch (e) {
          video.muted = wasMuted;
          video.dataset.slUgcPrimed = '1';
          return;
        }
        var cleanup = function() {
          try {
            video.pause();
            video.muted = wasMuted;
          } catch (e2) {}
          video.dataset.slUgcPrimed = '1';
        };
        video.addEventListener('seeked', cleanup, { once: true });
        setTimeout(function() {
          if (video.dataset.slUgcPrimed !== '1') cleanup();
        }, 750);
      };
      if (video.readyState >= 2) {
        go();
      } else {
        video.addEventListener('loadeddata', go, { once: true });
      }
    }

    root.querySelectorAll('[data-sl-pi-ugc]').forEach(function(wrap) {
      var track = wrap.querySelector('.sl-pi-ugc__track');
      var ugcScrollLock = false;
      var ugcScrollTimer;
      if (track) {
        track.addEventListener('scroll', function() {
          ugcScrollLock = true;
          clearTimeout(ugcScrollTimer);
          ugcScrollTimer = setTimeout(function() {
            ugcScrollLock = false;
          }, 260);
        }, { passive: true });
      }

      wrap.querySelectorAll('[data-sl-pi-ugc-item]').forEach(function(item) {
        var video = item.querySelector('video');
        if (!video) return;
        slPrimeUgcVideoFrame(video);

        var touchStartX;
        var touchStartY;
        var touchMoved = false;

        item.addEventListener('touchstart', function(e) {
          touchMoved = false;
          if (e.touches && e.touches[0]) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
          }
        }, { passive: true });

        item.addEventListener('touchmove', function(e) {
          if (!e.touches || !e.touches[0] || touchStartX === undefined) return;
          if (
            Math.abs(e.touches[0].clientX - touchStartX) > 12 ||
            Math.abs(e.touches[0].clientY - touchStartY) > 12
          ) {
            touchMoved = true;
          }
        }, { passive: true });

        function ugcApplyToggle() {
          if (video.paused) {
            try {
              video.currentTime = 0;
            } catch (e) {}
            video.muted = false;
            video.play().catch(function() {});
            item.classList.add('is-playing');
            return;
          }
          if (video.muted) {
            video.muted = false;
            video.play().catch(function() {});
            item.classList.add('is-playing');
            return;
          }
          video.pause();
          video.muted = true;
          try {
            video.currentTime = 0.06;
          } catch (e) {}
          item.classList.remove('is-playing');
        }

        item.addEventListener('click', function() {
          var skip = ugcScrollLock || touchMoved;
          touchMoved = false;
          if (skip) return;
          ugcApplyToggle();
        });

        item.addEventListener('mouseenter', function() {
          if (!slPiUgcIsDesktop()) return;
          if (!video.paused) return;
          video.muted = true;
          video.play().catch(function() {});
          item.classList.add('is-playing');
        });

        item.addEventListener('mouseleave', function() {
          if (!slPiUgcIsDesktop()) return;
          video.pause();
          video.muted = true;
          try {
            video.currentTime = 0.06;
          } catch (e) {}
          item.classList.remove('is-playing');
        });

        item.addEventListener('keydown', function(ev) {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            if (ugcScrollLock) return;
            ugcApplyToggle();
          }
        });
      });
    });
  })();
</script>



{%- if section.settings.sl_fade_up != false -%}
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');
  if(!root||root.dataset.slFadeBound)return;root.dataset.slFadeBound='1';
  var targets=root.querySelectorAll(':scope > .shopify-section, :scope > div, :scope > section');
  targets.forEach(function(t){t.classList.add('sl-fadeup');});
  if(!('IntersectionObserver' in window)){targets.forEach(function(t){t.classList.add('is-in');});return;}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
  targets.forEach(function(t){io.observe(t);});
})();
</script>
{%- endif -%}

