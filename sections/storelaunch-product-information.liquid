{%- liquid
  assign s = section.settings
  assign sl_skip_install_mask = false
  if request.design_mode
    assign sl_skip_install_mask = true
  endif
  if theme.role == 'development'
    assign sl_skip_install_mask = true
  endif
  assign selected_product = product
  if product == blank and s.product_handle != blank and all_products[s.product_handle] != blank
    assign selected_product = all_products[s.product_handle]
  endif
  assign product = selected_product
  assign desktop_thumbnail_mode = s.desktop_thumbnail_display
  if s.lock_desktop_thumbnail_display
    assign desktop_thumbnail_mode = 'grid_only'
  endif
  assign selected_variant = nil
  assign short_description = ''
  if product
    assign selected_variant = product.selected_or_first_available_variant
    assign short_description = product.description | strip_html | strip_newlines | truncatewords: 18
  endif
  assign has_variant_picker = false
  assign has_quantity_selector = false
  for block in section.blocks
    if block.type == 'variant_picker'
      assign has_variant_picker = true
    endif
    if block.type == 'quantity_selector'
      assign has_quantity_selector = true
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .sl-fadeup{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1);will-change:opacity,transform;}
  #shopify-section-{{ section.id }} .sl-fadeup.is-in{opacity:1;transform:none;}
  @media (prefers-reduced-motion: reduce){#shopify-section-{{ section.id }} .sl-fadeup{opacity:1!important;transform:none!important;transition:none!important;}}

  {{ section.settings.sl_mt_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }}, #shopify-section-{{ section.id }} * { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }} !important; }
:root { --sl-accent: {{ section.settings.accent_color | default: '#a891f6' }}; --sl-on-accent: #ffffff; }
#shopify-section-{{ section.id }} .sl-pi,
#shopify-section-{{ section.id }} .sl-pi * { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }}; }
#shopify-section-{{ section.id }} .sl-pi__title,
#shopify-section-{{ section.id }} .sl-pi h1,
#shopify-section-{{ section.id }} .sl-pi h2,
#shopify-section-{{ section.id }} .sl-pi h3 { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }}; font-weight: 700; letter-spacing: -0.01em; }
#shopify-section-{{ section.id }} .sl-pi__cta { width: 100%; text-transform: uppercase; letter-spacing: 0.04em; font-weight: 700; border-radius: 10px; padding: 18px 20px; }
#shopify-section-{{ section.id }} .sl-pi__sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 998; background: #fff; border-top: 1px solid rgba(0,0,0,0.08); box-shadow: 0 -4px 20px rgba(0,0,0,0.08); padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); transform: translateY(110%); transition: transform 0.25s ease; display: none; }
#shopify-section-{{ section.id }} .sl-pi__sticky.is-visible { transform: translateY(0); }
#shopify-section-{{ section.id }} .sl-pi__sticky-inner { display: flex; align-items: center; gap: 12px; max-width: 600px; margin: 0 auto; }
#shopify-section-{{ section.id }} .sl-pi__sticky-info { display: flex; flex-direction: column; line-height: 1.2; flex: 0 0 auto; }
#shopify-section-{{ section.id }} .sl-pi__sticky-title { font-size: {{ section.settings.sticky_title_fs | default: 11 }}px; opacity: 0.6; max-width: 110px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#shopify-section-{{ section.id }} .sl-pi__sticky-price { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }}; font-weight: 700; font-size: {{ section.settings.sticky_price_fs | default: 16 }}px; }
#shopify-section-{{ section.id }} .sl-pi__sticky-compare { font-weight: 400; font-size: {{ section.settings.sticky_compare_fs | default: 12 }}px; opacity: 0.5; margin-inline-start: 5px; }
#shopify-section-{{ section.id }} .sl-pi__sticky-btn { flex: 1; border: none; border-radius: 10px; padding: 14px; font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }}; font-weight: 700; font-size: {{ section.settings.sticky_btn_fs | default: 15 }}px; text-transform: uppercase; letter-spacing: 0.03em; cursor: pointer; }
@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .sl-pi__sticky { display: block; }
  #shopify-section-{{ section.id }} .sl-pi__sticky-title { font-size: {{ section.settings.sticky_title_fs_m | default: 11 }}px; }
  #shopify-section-{{ section.id }} .sl-pi__sticky-price { font-size: {{ section.settings.sticky_price_fs_m | default: 16 }}px; }
  #shopify-section-{{ section.id }} .sl-pi__sticky-compare { font-size: {{ section.settings.sticky_compare_fs_m | default: 12 }}px; }
  #shopify-section-{{ section.id }} .sl-pi__sticky-btn { font-size: {{ section.settings.sticky_btn_fs_m | default: 15 }}px; }
}
#shopify-section-{{ section.id }} .sl-pi__qty,
#shopify-section-{{ section.id }} .sl-pi__qty-wrap,
#shopify-section-{{ section.id }} .sl-pi__select { border-radius: 6px; }
#shopify-section-{{ section.id }} .sl-pi__accordion details { border-top: 1px solid rgba(0,0,0,0.08); }
#shopify-section-{{ section.id }} .sl-pi__accordion summary { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }}; font-weight: 600; padding: 16px 0; }
#shopify-section-{{ section.id }} .sl-pi__sale-badge,
#shopify-section-{{ section.id }} .kodu-star-badge-wrapper [class*="badge"] { border-radius: 40px; }
#shopify-section-{{ section.id }} [class*="trust-container"],
#shopify-section-{{ section.id }} [class*="review-card"] { border-radius: 8px; }
#shopify-section-{{ section.id }} {
  /* slfinal design tokens */
  --slf-accent: #a891f6;
  --slf-text: #121212;
  --slf-bg: #ffffff;
  --slf-btn-bg: #a891f6;
  --slf-btn-label: #ffffff;
  --slf-btn-radius: 10px;
  --slf-input-radius: 6px;
  --slf-heading-font: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }};
  --slf-body-font: 'Assistant', sans-serif;
  --slf-page-width: 1300px;
}

  #shopify-section-{{ section.id }}.sl-product-info-root {
    --sl-pi-bg: {{ s.section_bg }};
    --sl-pi-text: {{ s.text_color }};
    --sl-pi-muted: {{ s.muted_text_color }};
    --sl-pi-border: {{ s.border_color }};
    --sl-heading: {{ s.heading_fs | default: 30 }}px;
    --sl-body: {{ s.body_fs | default: 16 }}px;
    --sl-lh-heading: 1.15;
    --sl-lh-body: 1.55;
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
    background: var(--sl-pi-bg);
    color: var(--sl-pi-text);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}.sl-product-info-root {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }}.sl-product-info-root {
      --sl-heading: {{ s.heading_fs_m | default: 22 }}px;
      --sl-body: {{ s.body_fs_m | default: 14 }}px;
    }
    #shopify-section-{{ section.id }} .sl-pi__price { font-size: {{ s.price_fs_m | default: 16 }}px; }
    #shopify-section-{{ section.id }} .sl-pi__cta { font-size: {{ s.cta_fs_m | default: 17 }}px; }
    #shopify-section-{{ section.id }} .sl-pi__label { font-size: {{ s.label_fs_m | default: 14 }}px; }
  }

  #shopify-section-{{ section.id }} .sl-pi__wrap {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
    box-sizing: border-box;
    overflow-x: hidden;
    font-size: {{ s.base_fs | default: 16 }}px;
  }

  #shopify-section-{{ section.id }} .sl-pi__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 40px);
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-pi__layout {
      gap: 12px;
    }
    #shopify-section-{{ section.id }} .sl-pi__wrap { font-size: {{ s.base_fs_m | default: 15 }}px; }
    #shopify-section-{{ section.id }} .sl-pi2__summary { font-size: {{ s.summary_fs_m | default: 13 }}px; }
    #shopify-section-{{ section.id }} .sl-pi2__tp-label,
    #shopify-section-{{ section.id }} .sl-pi2__tp-count { font-size: {{ s.trustpilot_fs_m | default: 13 }}px; }
    #shopify-section-{{ section.id }} .sl-pi2__ship { font-size: {{ s.shipping_fs_m | default: 13 }}px; }
    #shopify-section-{{ section.id }} .sl-pi__select,
    #shopify-section-{{ section.id }} .sl-pi__qty { font-size: {{ s.field_fs_m | default: 16 }}px; }
    #shopify-section-{{ section.id }} .sl-pi__qty-btn { font-size: {{ s.qty_btn_fs_m | default: 18 }}px; }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sl-pi__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .sl-pi__wrap {
      padding: 0 clamp(20px, 3.2vw, 30px);
    }

    #shopify-section-{{ section.id }} .sl-pi__thumb-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sl-pi__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Let columns shrink below wide children (e.g. horizontal UGC strip) so the page does not overflow on mobile. */
  #shopify-section-{{ section.id }} .sl-pi__layout > * {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .sl-pi__left {
    display: grid;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .sl-pi__media-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .sl-pi__thumb-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .sl-pi__thumb-item {
    display: block;
    border: 0;
    border-radius: {{ s.thumbnail_radius | default: 10 }}px;
    background: transparent;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    appearance: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .sl-pi__thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-pi__thumb-grid {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: calc((100% - ({{ s.mobile_thumbnail_columns | default: 5 | minus: 1 }} * 8px)) / {{ s.mobile_thumbnail_columns | default: 5 }});
      grid-template-columns: none;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
      scroll-snap-type: x mandatory;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .sl-pi__thumb-grid::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .sl-pi__thumb-item {
      scroll-snap-align: start;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }

  @media screen and (min-width: 990px) {
    {% if desktop_thumbnail_mode == 'slider' %}
      #shopify-section-{{ section.id }} .sl-pi__thumb-grid {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: calc((100% - ({{ s.mobile_thumbnail_columns | default: 5 | minus: 1 }} * 8px)) / {{ s.mobile_thumbnail_columns | default: 5 }});
        grid-template-columns: none;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 4px;
        scroll-snap-type: x mandatory;
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      #shopify-section-{{ section.id }} .sl-pi__thumb-grid::-webkit-scrollbar {
        display: none;
      }

      #shopify-section-{{ section.id }} .sl-pi__thumb-item {
        scroll-snap-align: start;
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
      }
    {% elsif desktop_thumbnail_mode == 'grid_only' %}
      #shopify-section-{{ section.id }} .sl-pi__media-layout {
        display: block;
      }

      #shopify-section-{{ section.id }} .sl-pi__media {
        display: none;
      }

      #shopify-section-{{ section.id }} .sl-pi__thumb-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        overflow: visible;
        padding-bottom: 0;
      }

      #shopify-section-{{ section.id }} .sl-pi__thumb-item {
        pointer-events: none;
        cursor: default;
      }
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    {% unless desktop_thumbnail_mode == 'grid_only' %}
      #shopify-section-{{ section.id }} .sl-pi__thumb-item--featured {
        display: none;
      }
    {% endunless %}
  }

  #shopify-section-{{ section.id }} .sl-pi__media {
    border-radius: {{ s.media_radius }}px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
    aspect-ratio: 1 / 1;
  }

  #shopify-section-{{ section.id }} .sl-pi__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 220ms ease;
  }
  #shopify-section-{{ section.id }} .sl-pi__media img.is-swapping {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .sl-pi__title {
    margin: 0 0 10px;
    font-size: var(--sl-heading);
    line-height: var(--sl-lh-heading);
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--sl-pi-text);
  }

  #shopify-section-{{ section.id }} .kodu-star-badge-wrapper {
    width: 100%;
  }

  /* Prevent first-paint flash for product star badge before section initialization. */
  #shopify-section-{{ section.id }} .kodu-star-badge-wrapper[data-sl-pi-star] {
    opacity: 0;
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .kodu-star-badge-wrapper[data-sl-pi-star].is-ready {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.18s ease;
  }

  #shopify-section-{{ section.id }} .kodu-star-badge-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .kodu-star-badge-stars {
    position: relative;
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .kodu-star-badge-empty,
  #shopify-section-{{ section.id }} .kodu-star-badge-full {
    display: flex;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .kodu-star-badge-full {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .kodu-star-svg {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .kodu-star-badge-text strong {
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .sl-pi__price {
    margin: 0 0 12px;
    font-size: {{ s.price_fs | default: 20 }}px;
    font-weight: 600;
    color: var(--sl-pi-text);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .sl-pi__price-compare {
    color: var(--sl-pi-muted);
    text-decoration: line-through;
    font-size: 0.9em;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .sl-pi__desc,
  #shopify-section-{{ section.id }} .sl-pi__desc p,
  #shopify-section-{{ section.id }} .sl-pi__accordion-content,
  #shopify-section-{{ section.id }} .sl-pi__accordion-content p {
    margin: 0;
    font-size: var(--sl-body);
    line-height: var(--sl-lh-body);
    color: var(--sl-pi-muted);
  }

  #shopify-section-{{ section.id }} .sl-pi__desc {
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .sl-pi2__summary {
    margin: 25px 0 16px;
    font-size: {{ s.summary_fs | default: 14 }}px;
    line-height: 1.35;
    color: var(--sl-pi-text);
  }

  #shopify-section-{{ section.id }} .sl-pi2__summary-highlight {
    background: var(--sl-pi2-summary-hl-bg, {{ s.summary_highlight_bg | default: '#e9e9e9' }});
    color: var(--sl-pi2-summary-hl-color, {{ s.summary_highlight_color | default: '#000000' }});
    padding: 0.08em 0.26em;
    border-radius: 3px;
  }

  #shopify-section-{{ section.id }} .sl-pi2__tpbar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: clamp(8px, 1.7vw, 14px);
    width: 100%;
    margin-bottom: 10px;
    color: #0a0a0a;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sl-pi2__tp-label {
    font-size: {{ s.trustpilot_fs | default: 14 }}px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sl-pi2__tp-stars {
    display: flex;
    align-items: center;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .sl-pi2__tp-badge {
    width: min(100px, 100%);
    max-width: 100%;
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .sl-pi2__tp-count {
    margin: 0;
    font-size: {{ s.trustpilot_fs | default: 14 }}px;
    line-height: 1.2;
    color: #0a0a0a;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sl-pi2__tp-count strong {
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .sl-pi2__tp-count span {
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .sl-pi2__ship {
    margin-top: 14px;
    --ship-muted: #525252;
    --ship-fg: #171717;
    font-size: {{ s.shipping_fs | default: 14 }}px;
  }

  #shopify-section-{{ section.id }} .sl-pi2__ship-text {
    margin: 0;
    line-height: 1.5;
    color: var(--ship-muted);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sl-pi2__ship-lead,
  #shopify-section-{{ section.id }} .sl-pi2__ship-date {
    color: var(--ship-fg);
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .sl-sben__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sben-gap, 10px);
    width: fit-content;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .sl-sben__row {
    display: grid;
    grid-template-columns: 1.2em minmax(0, 1fr);
    column-gap: 0.55em;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .sl-sben__icon {
    width: 1.2em;
    height: 1.2em;
    margin-top: 0.12em;
    justify-self: start;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .sl-sben__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .sl-sben__text {
    line-height: 1.45;
    margin: 0;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .sl-sben__col {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .sl-pi__field {
    margin-bottom: 14px;
    display: grid;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .sl-pi__label {
    display: block;
    margin: 0;
    font-size: {{ s.label_fs | default: 14 }}px;
    font-weight: 600;
    color: var(--sl-pi-text);
  }

  #shopify-section-{{ section.id }} .sl-pi__select,
  #shopify-section-{{ section.id }} .sl-pi__qty {
    width: 100%;
    min-height: 50px;
    border: 1px solid var(--sl-pi-border);
    border-radius: 12px;
    padding: 0 14px;
    background: #fff;
    color: var(--sl-pi-text);
    font-size: {{ s.field_fs | default: 16 }}px;
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker.sl-pi__field {
    gap: 8px;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-options {
    display: grid;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .sl-pi__option-group {
    display: grid;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .sl-pi__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker {
    --sl-vp-btn-radius: 20px;
    --sl-vp-dropdown-radius: 12px;
    --sl-vp-control-size: {{ s.vp_control_fs | default: 15 }}px;
    --sl-vp-control-weight: 500;
    --sl-vp-control-line-height: 1.3;
    --sl-vp-label-gap: 8px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-pi__variant-picker {
      --sl-vp-control-size: {{ s.vp_control_fs_m | default: 14 }}px;
    }
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__label {
    margin: 0;
    padding: 0;
    font-size: var(--sl-vp-control-size);
    font-weight: var(--sl-vp-control-weight);
    line-height: var(--sl-vp-control-line-height);
    color: var(--sl-vp-label-color, var(--sl-pi-text));
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__option-group {
    gap: var(--sl-vp-label-gap);
  }

  #shopify-section-{{ section.id }} .sl-pi__select-wrap {
    position: relative;
    display: block;
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 100%;
    min-height: 48px;
    padding: 0 44px 0 16px;
    border: 1px solid var(--sl-vp-border, var(--sl-pi-border));
    border-radius: var(--sl-vp-dropdown-radius);
    background-color: var(--sl-vp-dropdown-bg, #fff);
    color: var(--sl-vp-dropdown-text, var(--sl-pi-text));
    font-size: var(--sl-vp-control-size);
    font-weight: var(--sl-vp-control-weight);
    line-height: var(--sl-vp-control-line-height);
    cursor: pointer;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__select:hover,
  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__select:focus,
  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__select:focus-visible,
  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__select:active {
    outline: none;
    box-shadow: none;
    border-color: var(--sl-vp-border, var(--sl-pi-border));
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__select-wrap::after {
    content: '';
    position: absolute;
    right: 18px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--sl-vp-label-color, var(--sl-pi-muted));
    border-bottom: 2px solid var(--sl-vp-label-color, var(--sl-pi-muted));
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__option-btn {
    min-height: 0;
    padding: 5px 12px;
    border: 1px solid var(--sl-vp-border, var(--sl-pi-border));
    border-radius: var(--sl-vp-btn-radius);
    background: var(--sl-vp-btn-bg, #fff);
    color: var(--sl-vp-btn-text, var(--sl-pi-text));
    font-size: var(--sl-vp-control-size);
    font-weight: var(--sl-vp-control-weight);
    line-height: var(--sl-vp-control-line-height);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__option-btn:hover:not(:disabled):not(.is-selected) {
    border-color: color-mix(in srgb, var(--sl-vp-border, var(--sl-pi-border)) 50%, var(--sl-vp-btn-text, var(--sl-pi-text)));
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__option-btn.is-selected {
    border-color: var(--sl-vp-btn-selected-bg, var(--sl-pi-text));
    background: var(--sl-vp-btn-selected-bg, var(--sl-pi-text));
    color: var(--sl-vp-btn-selected-text, #fff);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--sl-vp-btn-selected-bg, var(--sl-pi-text)) 22%, transparent);
  }

  #shopify-section-{{ section.id }} .sl-pi__variant-picker .sl-pi__option-btn.is-unavailable {
    opacity: 0.45;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  #shopify-section-{{ section.id }} .sl-pi__add-row {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: 20px;
  }

  #shopify-section-{{ section.id }} .sl-pi__qty-wrap {
    display: grid;
    grid-template-columns: 42px 1fr 42px;
    min-height: 50px;
    border: 1px solid var(--sl-pi-border);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .sl-pi__qty-btn {
    border: 0;
    background: #f8f8f8;
    color: var(--sl-pi-text);
    cursor: pointer;
    font-size: {{ s.qty_btn_fs | default: 19 }}px;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .sl-pi__qty {
    border: 0;
    text-align: center;
    min-height: 50px;
    padding: 0;
    border-radius: 0;
  }

  #shopify-section-{{ section.id }} .sl-pi__cta {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 55px;
    border: 0;
    border-radius: 15px;
    font-weight: 700;
    font-size: {{ s.cta_fs | default: 18 }}px;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .sl-pi__cta-price {
    font-size: 0.95em;
    font-weight: 600;
    opacity: 0.95;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sl-pi__pay {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .sl-pi__pay-icon {
    height: var(--pay-h, 26px);
    width: auto;
    display: block;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-pi__pay { gap: 6px; }
    #shopify-section-{{ section.id }} .sl-pi__pay-icon { height: calc(var(--pay-h, 26px) - 4px); }
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion {
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion details {
    border: 1px solid var(--sl-pi-border);
    border-radius: 12px;
    background: #fff;
    margin-bottom: 8px;
    overflow: hidden;
    transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion details:hover {
    border-color: rgba(0,0,0,0.18);
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion details[open] {
    border-color: color-mix(in srgb, var(--sl-accent) 55%, transparent);
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion summary {
    list-style: none;
    cursor: pointer;
    padding: 14px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    color: var(--sl-pi-text);
    font-size: {{ s.accordion_title_fs | default: 14 }}px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion-icon {
    position: relative;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-pi-muted);
    border-radius: 999px;
    background: rgba(0,0,0,0.04);
    transition: transform 220ms ease, background 220ms ease, color 220ms ease;
    flex: 0 0 auto;
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion-icon::before {
    content: "+";
    font-size: 16px;
    line-height: 1;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion details[open] .sl-pi__accordion-icon {
    transform: rotate(45deg);
    background: color-mix(in srgb, var(--sl-accent) 14%, transparent);
    color: var(--sl-accent);
  }

  #shopify-section-{{ section.id }} .sl-pi__accordion-content {
    padding: 0 16px 16px;
    color: var(--sl-pi-muted);
    font-size: {{ s.accordion_body_fs | default: 14 }}px;
    line-height: 1.6;
    animation: sl-pi-acc-in 240ms ease both;
  }

  @keyframes sl-pi-acc-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-pi__accordion summary {
      font-size: {{ s.accordion_title_fs_m | default: 13 }}px;
    }
    #shopify-section-{{ section.id }} .sl-pi__accordion-content,
    #shopify-section-{{ section.id }} .sl-pi__accordion-content p {
      font-size: {{ s.accordion_body_fs_m | default: 13 }}px;
    }
  }

  #shopify-section-{{ section.id }} .sl-track {
    width: 100%;
    box-sizing: border-box;
    margin-top: 12px;
  }

  #shopify-section-{{ section.id }} .sl-track__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    width: 100%;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .sl-track__item {
    flex: 1 1 0;
    position: relative;
    text-align: center;
    min-width: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sl-track__item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: calc(var(--track-icon-size) / 2);
    left: calc(50% + var(--track-icon-size) / 2);
    width: calc(100% - var(--track-icon-size));
    height: 2px;
    background: var(--track-line);
    z-index: 0;
    transform: translateY(-50%);
  }

  #shopify-section-{{ section.id }} .sl-track__icon-ring {
    position: relative;
    z-index: 1;
    width: var(--track-icon-size);
    height: var(--track-icon-size);
    margin: 0 auto 0.65em;
    border-radius: 50%;
    background: var(--track-icon-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--track-accent);
  }

  #shopify-section-{{ section.id }} .sl-track__icon-ring svg {
    width: 55%;
    height: 55%;
    display: block;
  }

  #shopify-section-{{ section.id }} .sl-track__icon-ring .ph-duotone {
    font-size: 22px;
    line-height: 1;
    color: var(--track-accent);
  }

  #shopify-section-{{ section.id }} .sl-track__date {
    margin: 0;
    font-size: 0.92em;
    font-weight: 500;
    color: var(--track-text, #171717);
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .sl-track__status {
    margin: 0.15em 0 0;
    font-size: 1.05em;
    font-weight: 700;
    color: var(--track-text, #171717);
    line-height: 1.2;
  }
{%- endstyle -%}



<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Assistant:wght@400;600;700&display=swap">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/duotone/style.css">

<div id="storelaunch-product-information-top" class="sl-pi__wrap">
  <div class="sl-pi__layout">
    <div class="sl-pi__left">
      <div class="sl-pi__media-layout{% if desktop_thumbnail_mode == 'grid_only' %} sl-pi__media-layout--grid-only{% endif %}">
        <div class="sl-pi__media">
          {% if product.featured_media %}
            <img
              class="sl-pi__main-img"
              src="{{ product.featured_media | image_url: width: 1400 }}"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              loading="eager"
              fetchpriority="high"
            >
          {% endif %}
        </div>

        {% liquid
          assign other_images = product.media | where: 'media_type', 'image'
          assign featured_thumb_id = false
          if product.featured_media and product.featured_media.media_type == 'image'
            assign featured_thumb_id = product.featured_media.id
          endif
        %}
        {% if other_images.size > 0 %}
          <div class="sl-pi__thumb-grid">
            {% for media in other_images %}
              <button
                type="button"
                class="sl-pi__thumb-item{% if featured_thumb_id and media.id == featured_thumb_id %} sl-pi__thumb-item--featured{% endif %}"
                data-sl-pi-thumb
                data-media-id="{{ media.id }}"
                data-full-src="{{ media | image_url: width: 1400 }}"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="View product image {{ forloop.index }}"
              >
                {{ media | image_url: width: 520 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="sl-pi__content">
      {% if product %}
      {% form 'product', product %}
        {% if has_variant_picker == false %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
        {% endif %}
        {% if has_quantity_selector == false %}
          <input type="hidden" name="quantity" value="1">
        {% endif %}

        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'star_badge' %}
              {% assign rating_value = block.settings.rating_value | default: 4.7 | plus: 0 %}
              {% assign rating_width = rating_value | times: 20 %}
              <div
                class="kodu-star-badge-wrapper"
                data-sl-pi-star
                style="margin-top: {{ block.settings.wrapper_margin_top }}px; margin-bottom: {{ block.settings.wrapper_margin_bottom }}px;"
                {{ block.shopify_attributes }}
              >
                <div
                  class="kodu-star-badge-row"
                  style="justify-content: {{ block.settings.align_web }}; gap: {{ block.settings.gap }}px;"
                >
                  <div class="kodu-star-badge-stars">
                    <div class="kodu-star-badge-empty">
                      {% for i in (1..5) %}
                        <svg class="kodu-star-svg" style="width: {{ block.settings.star_size }}px; height: {{ block.settings.star_size }}px; fill: {{ block.settings.empty_star_color }};" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6L22 9.2l-5 4.9 1.2 7L12 17.8 5.8 21l1.2-7-5-4.9 7.1-0.6z"/></svg>
                      {% endfor %}
                    </div>
                    <div class="kodu-star-badge-full" style="width: {{ rating_width }}%;">
                      {% for i in (1..5) %}
                        <svg class="kodu-star-svg" style="width: {{ block.settings.star_size }}px; height: {{ block.settings.star_size }}px; fill: {% if block.settings.star_color != blank %}{{ block.settings.star_color }}{% else %}var(--sl-accent){% endif %};" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6L22 9.2l-5 4.9 1.2 7L12 17.8 5.8 21l1.2-7-5-4.9 7.1-0.6z"/></svg>
                      {% endfor %}
                    </div>
                  </div>

                  <div class="kodu-star-badge-text" style="font-size: {{ block.settings.text_size }}px; color: {{ block.settings.text_color }};">
                    <strong>{{ block.settings.rating_label }} {{ block.settings.rating_value }}</strong>
                    <span style="color: {{ block.settings.count_color }}; margin-left: 2px;">({{ block.settings.reviews_count }})</span>
                  </div>

                  {% if block.settings.show_badge %}
                    <div style="background: {% if block.settings.badge_bg != blank %}{{ block.settings.badge_bg }}{% else %}var(--sl-accent){% endif %}; color: {% if block.settings.badge_text_color != blank %}{{ block.settings.badge_text_color }}{% else %}var(--sl-on-accent){% endif %}; padding: 2px 6px; border-radius: {{ block.settings.badge_radius }}px; font-size: {{ block.settings.badge_size }}px;">
                      {{ block.settings.badge_text }}
                    </div>
                  {% endif %}
                </div>
              </div>

            {% when 'title' %}
              <h1
                class="sl-pi__title"
                style="font-size: {{ block.settings.font_size | default: 28 }}px; color: {{ block.settings.text_color | default: s.text_color }};"
                {{ block.shopify_attributes }}
              >{{ product.title | escape }}</h1>

            {% when 'price' %}
              <p
                class="sl-pi__price"
                style="font-size: {{ block.settings.font_size | default: 18 }}px; color: {{ block.settings.text_color | default: s.text_color }};"
                {{ block.shopify_attributes }}
              >
                <span>{{ selected_variant.price | money }}</span>
                {% if selected_variant.compare_at_price > selected_variant.price %}
                  <span
                    class="sl-pi__price-compare"
                    style="color: {{ block.settings.compare_color | default: s.muted_text_color }};"
                  >{{ selected_variant.compare_at_price | money }}</span>
                {% endif %}
              </p>
              {% if block.settings.quote != blank %}
                <div class="sl-pi__pullquote" style="border-inline-start: 3px solid {{ block.settings.text_color | default: s.text_color }}; background: {{ block.settings.text_color | default: s.text_color | color_modify: 'alpha', 0.04 }}; border-radius: 0 8px 8px 0; padding: 10px 14px; margin: 12px 0 2px;">
                  <p style="margin: 0; font-style: italic; font-size: 13.5px; line-height: 1.45; color: {{ s.text_color }};">{{ block.settings.quote }}</p>
                  {% if block.settings.quote_author != blank %}
                    <p style="margin: 4px 0 0; font-size: 11.5px; font-weight: 600; color: {{ s.muted_text_color }};">{{ block.settings.quote_author }}</p>
                  {% endif %}
                </div>
              {% endif %}

            {% when 'trustpilot_row' %}
              <div class="sl-pi2__tpbar" {{ block.shopify_attributes }}>
                <span class="sl-pi2__tp-label" style="font-size: {{ block.settings.label_size | default: 14 }}px; font-weight: {{ block.settings.label_weight | default: '600' }};">{{ block.settings.label | default: 'Excellent' }}</span>
                <div class="sl-pi2__tp-stars" role="img" aria-label="{{ block.settings.rating | default: '4.8' }} out of 5 stars">
                  <img
                    class="sl-pi2__tp-badge"
                    src="{{ block.settings.badge_image | default: 'https://i.imgur.com/EHjNmTM.png' }}"
                    width="100"
                    height="20"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  >
                </div>
                <p class="sl-pi2__tp-count">
                  <strong>{{ block.settings.review_count | default: '20,921' }}</strong>
                  <span> {{ block.settings.reviews_label | default: 'reviews' }}</span>
                </p>
              </div>


            {% when 'low_stock' %}
              {% if block.settings.show %}
                {%- liquid
                  assign day_seed = 'now' | date: '%j' | plus: 0
                  assign stk_min = block.settings.stock_min | default: 4
                  assign stk_max = block.settings.stock_max | default: 22
                  assign stock_left = day_seed | modulo: 11 | plus: 5
                  if stock_left < stk_min
                    assign stock_left = stk_min
                  endif
                  if stock_left > stk_max
                    assign stock_left = stk_max
                  endif
                  assign stk_uid = block.id | handleize | default: 'stk'
                  assign stk_lead = block.settings.lead | default: 'Low stock, only '
                  assign stk_tail = block.settings.tail | default: ' left'
                -%}
                <div
                  class="sl-stk sl-stk--{{ stk_uid }}"
                  data-min="{{ stk_min }}"
                  data-max="{{ stk_max }}"
                  data-tick-min-ms="{{ block.settings.tick_min_sec | default: 15 | times: 1000 }}"
                  data-tick-max-ms="{{ block.settings.tick_max_sec | default: 30 | times: 1000 }}"
                  data-pause-min-ms="{{ block.settings.pause_min_sec | default: 45 | times: 1000 }}"
                  data-pause-extra-ms="{{ block.settings.pause_extra_sec | default: 60 | times: 1000 }}"
                  style="
                    --stk-accent: {{ block.settings.accent_color | default: '#dc2626' }};
                    --stk-text: {{ block.settings.text_color | default: '#171717' }};
                    font-size: {{ block.settings.font_size | default: 14 }}px;
                    margin-top: {{ block.settings.margin_top | default: 6 }}px;
                    margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;
                  "
                  {{ block.shopify_attributes }}
                >
                  <style>
                    @keyframes sl-stk-pulse--{{ stk_uid }} {
                      0% {
                        box-shadow:
                          0 0 0 0 color-mix(in srgb, var(--stk-accent) 36%, transparent),
                          0 0 1px 1px rgba(0, 0, 0, 0.1);
                      }
                      100% {
                        box-shadow:
                          0 0 0 0.42em color-mix(in srgb, var(--stk-accent) 0%, transparent),
                          0 0 1px 1px rgba(0, 0, 0, 0.1);
                      }
                    }
                    .sl-stk--{{ stk_uid }} .sl-stk__inner {
                      display: flex;
                      align-items: center;
                      gap: 0.72em;
                      flex-wrap: wrap;
                    }
                    .sl-stk--{{ stk_uid }} .sl-stk__dot {
                      flex-shrink: 0;
                      width: 0.74em;
                      height: 0.74em;
                      border-radius: 50%;
                      background: var(--stk-accent);
                      margin-inline-end: 0.06em;
                      will-change: box-shadow;
                      animation: sl-stk-pulse--{{ stk_uid }} 2s infinite;
                    }
                    @media (prefers-reduced-motion: reduce) {
                      .sl-stk--{{ stk_uid }} .sl-stk__dot {
                        animation: none;
                        opacity: 1;
                        box-shadow: none;
                      }
                    }
                    .sl-stk--{{ stk_uid }} .sl-stk__line {
                      margin: 0;
                      color: var(--stk-text);
                      line-height: 1.45;
                    }
                    .sl-stk--{{ stk_uid }} .sl-stk__num {
                      font-weight: 700;
                      color: var(--stk-accent);
                      font-variant-numeric: tabular-nums;
                      margin-inline: 0.18em;
                    }
                  </style>
                  <div class="sl-stk__inner">
                    <span class="sl-stk__dot" aria-hidden="true"></span>
                    <p class="sl-stk__line">
                      <span class="sl-stk__lead">{{ stk_lead | escape }}</span>{% if block.settings.show_number %}<span class="sl-stk__num" data-sl-stk>{{ stock_left }}</span><span class="sl-stk__tail">{{ stk_tail | escape }}</span>{% endif %}
                    </p>
                  </div>
                  <script>
                    (function () {
                      var root = document.currentScript && document.currentScript.closest('.sl-stk--{{ stk_uid }}');
                      if (!root) return;
                      var el = root.querySelector('[data-sl-stk]');
                      if (!el) return;
                      var min = parseInt(root.getAttribute('data-min'), 10) || 4;
                      var max = parseInt(root.getAttribute('data-max'), 10) || 22;
                      if (max < min) max = min;
                      var tickMin = parseInt(root.getAttribute('data-tick-min-ms'), 10) || 15000;
                      var tickMax = parseInt(root.getAttribute('data-tick-max-ms'), 10) || 30000;
                      if (tickMax < tickMin) tickMax = tickMin;
                      var pauseMin = parseInt(root.getAttribute('data-pause-min-ms'), 10) || 45000;
                      var pauseExtra = parseInt(root.getAttribute('data-pause-extra-ms'), 10) || 60000;
                      var current = parseInt(String(el.textContent).replace(/\D/g, ''), 10);
                      if (isNaN(current)) current = Math.round((min + max) / 2);
                      current = Math.min(max, Math.max(min, current));
                      el.textContent = String(current);
                      var target = current;
                      var idleUntil = 0;
                      var resting = true;
                      function pickTarget() {
                        if (current <= min) {
                          target = current;
                          return;
                        }
                        var hi = current - 1;
                        if (hi < min) {
                          target = current;
                          return;
                        }
                        target = min + Math.floor(Math.random() * (hi - min + 1));
                      }
                      function nextTickDelay() {
                        return tickMin + Math.random() * (tickMax - tickMin);
                      }
                      function schedule(ms) {
                        setTimeout(tick, Math.max(0, Math.round(ms)));
                      }
                      function tick() {
                        var now = Date.now();
                        if (current === target) {
                          if (resting && now >= idleUntil) {
                            pickTarget();
                            if (current === target) {
                              idleUntil = now + 2000;
                              schedule(Math.max(250, idleUntil - now));
                            } else {
                              resting = false;
                              schedule(nextTickDelay());
                            }
                          } else if (resting) {
                            schedule(Math.max(250, idleUntil - now));
                          } else {
                            schedule(250);
                          }
                          return;
                        }
                        if (current > target) {
                          current--;
                          el.textContent = String(current);
                        }
                        if (current === target) {
                          idleUntil = now + pauseMin + Math.random() * pauseExtra;
                          resting = true;
                          schedule(Math.max(250, idleUntil - now));
                        } else {
                          schedule(nextTickDelay());
                        }
                      }
                      tick();
                    })();
                  </script>
                </div>
              {% endif %}

            {% when 'variant_picker' %}
