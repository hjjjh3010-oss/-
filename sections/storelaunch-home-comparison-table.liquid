{%- liquid
  assign s = section.settings
  assign sl_skip_install_mask = false
  if request.design_mode
    assign sl_skip_install_mask = true
  endif
  if theme.role == 'development'
    assign sl_skip_install_mask = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .sl-fadeup{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1);will-change:opacity,transform;}
  #shopify-section-{{ section.id }} .sl-fadeup.is-in{opacity:1;transform:none;}
  @media (prefers-reduced-motion: reduce){#shopify-section-{{ section.id }} .sl-fadeup{opacity:1!important;transform:none!important;transition:none!important;}}

  {{ section.settings.sl_mt_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }}, #shopify-section-{{ section.id }} * { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }} !important; }
  #shopify-section-{{ section.id }}.sl-comparison-root {
    --sl-comp-bg: {{ s.section_bg }};
    --sl-comp-text: {{ s.text_color }};
    --sl-comp-muted: {{ s.subtext_color }};
    --sl-comp-line: {{ s.line_color }};
    --sl-comp-highlight: {{ s.highlight_bg }};
    --sl-comp-check-bg: {{ s.check_bg }};
    --sl-comp-check-icon: {{ s.check_icon }};
    --sl-comp-cross-bg: {{ s.cross_bg }};
    --sl-comp-cross-icon: {{ s.cross_icon }};
    --sl-comp-btn-bg: {{ s.button_bg }};
    --sl-comp-btn-text: {{ s.button_text }};
    --sl-heading: {{ s.heading_fs }}px;
    --sl-body: {{ s.body_fs }}px;
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
    background: var(--sl-comp-bg);
    color: var(--sl-comp-text);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}.sl-comparison-root {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .sl-comp {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sl-comp__title {
    margin: 0;
    text-align: center;
    font-size: var(--sl-heading);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .sl-comp__sub {
    margin: 14px auto 0;
    text-align: center;
    max-width: 56ch;
    color: var(--sl-comp-muted);
    font-size: var(--sl-body);
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .sl-comp__sub p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .sl-comp__table-wrap {
    margin-top: clamp(24px, 4vw, 34px);
    overflow-x: auto;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sl-comp {
      padding: 0 clamp(20px, 3.2vw, 30px);
    }

    #shopify-section-{{ section.id }} .sl-comp__table thead th {
      font-size: {{ s.col_heading_fs }}px;
      padding: 12px 10px;
    }

    #shopify-section-{{ section.id }} .sl-comp__table tbody td {
      padding: 11px 10px;
    }
  }

  #shopify-section-{{ section.id }} .sl-comp__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  #shopify-section-{{ section.id }} .sl-comp__table thead th {
    font-size: {{ s.col_heading_fs }}px;
    line-height: 1.2;
    font-weight: 700;
    padding: 16px 12px;
    text-align: center;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  #shopify-section-{{ section.id }} .sl-comp__table thead th:first-child {
    text-align: left;
    width: 34%;
  }

  #shopify-section-{{ section.id }} .sl-comp__table thead th:nth-child(2),
  #shopify-section-{{ section.id }} .sl-comp__table thead th:nth-child(3) {
    width: 33%;
  }

  #shopify-section-{{ section.id }} .sl-comp__table thead th:nth-child(2),
  #shopify-section-{{ section.id }} .sl-comp__table tbody td:nth-child(2) {
    background: var(--sl-comp-highlight);
  }

  #shopify-section-{{ section.id }} .sl-comp__table thead th:nth-child(2) {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
  }

  #shopify-section-{{ section.id }} .sl-comp__table tbody td {
    border-top: 1px solid var(--sl-comp-line);
    padding: 12px 12px;
    vertical-align: middle;
  }

  #shopify-section-{{ section.id }} .sl-comp__feature {
    font-size: var(--sl-body);
    line-height: 1.4;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .sl-comp__icon-cell {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sl-comp__icon {
    display: inline-flex;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .sl-comp__icon svg {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }} .sl-comp__icon--check {
    background: var(--sl-comp-check-bg);
    color: var(--sl-comp-check-icon);
  }

  #shopify-section-{{ section.id }} .sl-comp__icon--cross {
    background: var(--sl-comp-cross-bg);
    color: var(--sl-comp-cross-icon);
  }

  #shopify-section-{{ section.id }} .sl-comp__cta-wrap {
    margin-top: 20px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sl-comp__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background: var(--sl-comp-btn-bg);
    color: var(--sl-comp-btn-text);
    border-radius: 10px;
    min-height: 48px;
    padding: 0 24px;
    font-size: {{ s.button_fs }}px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-comp__table-wrap {
      overflow-x: visible;
    }

    #shopify-section-{{ section.id }} .sl-comp__table thead th {
      font-size: {{ s.col_heading_fs_m }}px;
      line-height: 1.3;
      padding: 10px 6px;
    }

    #shopify-section-{{ section.id }} .sl-comp__title {
      font-size: {{ s.heading_fs_m }}px;
    }

    #shopify-section-{{ section.id }} .sl-comp__sub {
      font-size: {{ s.body_fs_m }}px;
    }

    #shopify-section-{{ section.id }} .sl-comp__cta {
      font-size: {{ s.button_fs_m }}px;
    }

    #shopify-section-{{ section.id }} .sl-comp__table thead th:first-child {
      width: 50%;
    }

    #shopify-section-{{ section.id }} .sl-comp__table thead th:nth-child(2),
    #shopify-section-{{ section.id }} .sl-comp__table thead th:nth-child(3) {
      width: 25%;
    }

    #shopify-section-{{ section.id }} .sl-comp__table thead th:nth-child(2) {
      border-top-left-radius: 8px;
      border-top-right-radius: 8px;
    }

    #shopify-section-{{ section.id }} .sl-comp__table tbody td {
      padding: 10px 8px;
    }

    #shopify-section-{{ section.id }} .sl-comp__feature {
      font-size: {{ s.body_fs_m }}px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .sl-comp__icon {
      width: 24px;
      height: 24px;
    }

    #shopify-section-{{ section.id }} .sl-comp__icon svg {
      width: 14px;
      height: 14px;
    }
  }
{%- endstyle -%}



<div class="sl-comp">
  {% if s.heading != blank %}
    <h2 class="sl-comp__title">{{ s.heading | escape }}</h2>
  {% endif %}
  {% if s.subtext != blank %}
    <div class="sl-comp__sub rte">{{ s.subtext }}</div>
  {% endif %}

  <div class="sl-comp__table-wrap">
    <table class="sl-comp__table" role="table">
      <thead>
        <tr>
          <th scope="col"></th>
          <th scope="col">{{ s.left_column_heading | escape }}</th>
          <th scope="col">{{ s.right_column_heading | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          {% if block.type == 'row' %}
            <tr {{ block.shopify_attributes }}>
              <td class="sl-comp__feature">{{ block.settings.feature | escape }}</td>
              <td class="sl-comp__icon-cell">
                <span class="sl-comp__icon {% if block.settings.left_included %}sl-comp__icon--check{% else %}sl-comp__icon--cross{% endif %}">
                  {% if block.settings.left_included %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 13l4 4L19 7"></path>
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" aria-hidden="true">
                      <path d="M7 7l10 10M17 7L7 17"></path>
                    </svg>
                  {% endif %}
                </span>
              </td>
              <td class="sl-comp__icon-cell">
                <span class="sl-comp__icon {% if block.settings.right_included %}sl-comp__icon--check{% else %}sl-comp__icon--cross{% endif %}">
                  {% if block.settings.right_included %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 13l4 4L19 7"></path>
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" aria-hidden="true">
                      <path d="M7 7l10 10M17 7L7 17"></path>
                    </svg>
                  {% endif %}
                </span>
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if s.button_label != blank %}
    {%- liquid
      assign sl_comp_cta_url = s.button_link
      if sl_comp_cta_url == blank and collections.all != blank and collections.all.products_count > 0
        assign sl_comp_cta_product = collections.all.products | sort: 'created_at' | last
        if sl_comp_cta_product == blank
          assign sl_comp_cta_product = collections.all.products.first
        endif
        assign sl_comp_cta_url = sl_comp_cta_product.url
      endif
      if sl_comp_cta_url == blank
        assign sl_comp_cta_url = routes.all_products_collection_url
      endif
    -%}
    <div class="sl-comp__cta-wrap">
      <a
        class="sl-comp__cta"
        data-slh-comp-cta
        href="{{ sl_comp_cta_url }}"
      >
        {{ s.button_label | escape }}
      </a>
    </div>
  {% endif %}
</div>



{%- if section.settings.sl_fade_up != false -%}
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');
  if(!root||root.dataset.slFadeBound)return;root.dataset.slFadeBound='1';
  var targets=root.querySelectorAll(':scope > .shopify-section, :scope > div, :scope > section');
  targets.forEach(function(t){t.classList.add('sl-fadeup');});
  if(!('IntersectionObserver' in window)){targets.forEach(function(t){t.classList.add('is-in');});return;}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
  targets.forEach(function(t){io.observe(t);});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SL Comparison Table",
  "tag": "section",
  "class": "sl-comparison-root",
  "settings": [
    {
      "type": "font_picker",
      "id": "sl_mt_font",
      "label": "Font family",
      "default": "montserrat_n4"
    },
    {
      "type": "checkbox",
      "id": "sl_fade_up",
      "label": "Entrance animation (fade up on scroll)",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Switch to Filtered Shower Water?"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Hard water can damage your hair and skin over time. See why filtered water makes a difference.</p>"
    },
    {
      "type": "text",
      "id": "left_column_heading",
      "label": "Left column heading",
      "default": "Filtered Showerhead"
    },
    {
      "type": "text",
      "id": "right_column_heading",
      "label": "Right column heading",
      "default": "Regular Showerheads"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Upgrade your shower"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Font Sizes"
    },
    { "type": "range", "id": "heading_fs", "min": 16, "max": 52, "step": 1, "unit": "px", "label": "Heading size (desktop)", "default": 30 },
    { "type": "range", "id": "heading_fs_m", "min": 14, "max": 44, "step": 1, "unit": "px", "label": "Heading size (mobile)", "default": 22 },
    { "type": "range", "id": "body_fs", "min": 11, "max": 24, "step": 1, "unit": "px", "label": "Body & feature text size (desktop)", "default": 16 },
    { "type": "range", "id": "body_fs_m", "min": 11, "max": 22, "step": 1, "unit": "px", "label": "Body & feature text size (mobile)", "default": 14 },
    { "type": "range", "id": "col_heading_fs", "min": 12, "max": 38, "step": 1, "unit": "px", "label": "Column heading size (desktop)", "default": 24 },
    { "type": "range", "id": "col_heading_fs_m", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "Column heading size (mobile)", "default": 15 },
    { "type": "range", "id": "button_fs", "min": 11, "max": 24, "step": 1, "unit": "px", "label": "Button text size (desktop)", "default": 14 },
    { "type": "range", "id": "button_fs_m", "min": 11, "max": 22, "step": 1, "unit": "px", "label": "Button text size (mobile)", "default": 14 },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Row divider color",
      "default": "#1e4d3a"
    },
    {
      "type": "color",
      "id": "highlight_bg",
      "label": "Center column background",
      "default": "#f4f1e8"
    },
    {
      "type": "color",
      "id": "check_bg",
      "label": "Check icon background",
      "default": "#1e4d3a"
    },
    {
      "type": "color",
      "id": "check_icon",
      "label": "Check icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cross_bg",
      "label": "Cross icon background",
      "default": "rgba(0,0,0,0.3)"
    },
    {
      "type": "color",
      "id": "cross_icon",
      "label": "Cross icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#1e4d3a"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
