          "id": "right_included",
          "label": "Included in right column",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SL Comparison Table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature": "Removes chlorine",
            "left_included": true,
            "right_included": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Reduces hard water minerals",
            "left_included": true,
            "right_included": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Healthier hair",
            "left_included": true,
            "right_included": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Softer skin",
            "left_included": true,
            "right_included": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Less scalp dryness",
            "left_included": true,
            "right_included": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Better water quality",
            "left_included": true,
            "right_included": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
