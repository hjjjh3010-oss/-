{%- comment -%}
  Icons: simple white line-art for benefit blocks
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sl_skip_install_mask = false
  if request.design_mode
    assign sl_skip_install_mask = true
  endif
  if theme.role == 'development'
    assign sl_skip_install_mask = true
  endif
-%}

{%- style -%}
  @import url("https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css");
  #shopify-section-{{ section.id }} .sl-fadeup{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1);will-change:opacity,transform;}
  #shopify-section-{{ section.id }} .sl-fadeup.is-in{opacity:1;transform:none;}
  @media (prefers-reduced-motion: reduce){#shopify-section-{{ section.id }} .sl-fadeup{opacity:1!important;transform:none!important;transition:none!important;}}

  {{ section.settings.sl_mt_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }}, #shopify-section-{{ section.id }} * { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }} !important; }
  #shopify-section-{{ section.id }}[class*="sl-"] {
    font-size: {{ s.base_fs }}px;
  }
  #shopify-section-{{ section.id }} {
    --sl-iwb-bg: {{ s.section_bg }};
    --sl-iwb-text: {{ s.text_color }};
    --sl-iwb-muted: {{ s.muted_text_color }};
    --sl-iwb-radius: {{ s.image_radius }}px;
    --sl-heading: {{ s.heading_fs }}px;
    --sl-body: {{ s.body_fs }}px;
    --sl-lh-heading: 1.15;
    --sl-lh-body: 1.55;
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
    background: var(--sl-iwb-bg);
    color: var(--sl-iwb-text);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ s.desktop_margin_top | default: 24 }}px;
    }
    /* Template 4 converted section keeps key "sl_image_description"; force no top gap there only. */
    #shopify-section-{{ section.id }}[id*="sl_image_description"] {
      margin-top: 0 !important;
    }
  }

  #shopify-section-{{ section.id }} .sl-iwb__wrap {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .sl-iwb__grid-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 6vw, 64px);
    align-items: center;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sl-iwb__wrap {
      padding: 0 clamp(20px, 3.2vw, 30px);
    }

    #shopify-section-{{ section.id }} .sl-iwb__grid-main {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 24px;
      align-items: start;
    }

    #shopify-section-{{ section.id }} .sl-iwb__media {
      order: 0;
      justify-self: center;
      max-height: none;
      aspect-ratio: {{ s.image_aspect_ratio }};
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sl-iwb__grid-main {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: clamp(40px, 6vw, 80px);
    }
  }

  #shopify-section-{{ section.id }} .sl-iwb__eyebrow {
    margin: 0 0 12px;
    font-size: var(--sl-body);
    line-height: var(--sl-lh-body);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-iwb-muted);
  }

  #shopify-section-{{ section.id }} .sl-iwb__heading {
    margin: 0 0 clamp(28px, 4vw, 40px);
    font-size: var(--sl-heading);
    font-weight: 700;
    line-height: var(--sl-lh-heading);
    letter-spacing: -0.02em;
    color: var(--sl-iwb-text);
  }

  #shopify-section-{{ section.id }} .sl-iwb__benefits {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 28px);
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .sl-iwb__benefits {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(20px, 3vw, 36px);
      row-gap: clamp(24px, 3vw, 32px);
    }
  }

  #shopify-section-{{ section.id }} .sl-iwb__benefit {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .sl-iwb__title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .sl-iwb__title-icon {
    color: var(--sl-iwb-text);
    font-size: {{ s.icon_fs }}px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sl-iwb__title {
    margin: 0;
    font-size: var(--sl-body);
    font-weight: 700;
    line-height: var(--sl-lh-body);
    color: var(--sl-iwb-text);
  }

  #shopify-section-{{ section.id }} .sl-iwb__desc,
  #shopify-section-{{ section.id }} .sl-iwb__desc p {
    margin: 0;
    font-size: var(--sl-body);
    line-height: var(--sl-lh-body);
    font-weight: 400;
    color: var(--sl-iwb-muted);
  }

  #shopify-section-{{ section.id }} .sl-iwb__media {
    position: relative;
    border-radius: var(--sl-iwb-radius);
    overflow: hidden;
    aspect-ratio: {{ s.image_aspect_ratio }};
    background: rgba(255, 255, 255, 0.06);
    max-width: 380px;
    width: 100%;
    justify-self: end;
  }

  #shopify-section-{{ section.id }} .sl-iwb__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    vertical-align: middle;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sl-iwb__media {
      order: -1;
      justify-self: center;
      max-height: 420px;
      aspect-ratio: 4 / 3;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sl-iwb__media {
      order: 0;
      max-height: none;
      aspect-ratio: {{ s.image_aspect_ratio }};
    }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-iwb__wrap { padding: 0 1rem; }
    #shopify-section-{{ section.id }} .sl-iwb__benefits { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }}[class*="sl-"] { font-size: {{ s.base_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-iwb__heading { font-size: {{ s.heading_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-iwb__eyebrow,
    #shopify-section-{{ section.id }} .sl-iwb__title,
    #shopify-section-{{ section.id }} .sl-iwb__desc,
    #shopify-section-{{ section.id }} .sl-iwb__desc p { font-size: {{ s.body_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-iwb__title-icon { font-size: {{ s.icon_fs_m }}px; }
  }
{%- endstyle -%}




<div class="sl-iwb__wrap">
  <div class="sl-iwb__grid-main">
    <div class="sl-iwb__text">
      {% if s.eyebrow != blank %}
        <p class="sl-iwb__eyebrow">{{ s.eyebrow | escape }}</p>
      {% endif %}
      {% if s.heading != blank %}
        <h2 class="sl-iwb__heading">{{ s.heading | escape }}</h2>
      {% endif %}

      <div class="sl-iwb__benefits">
        {% for block in section.blocks %}
          <div class="sl-iwb__benefit" {{ block.shopify_attributes }}>
            {% if block.settings.title != blank %}
              <div class="sl-iwb__title-row">
                {% if block.settings.icon != blank and block.settings.icon != 'none' %}
                  <span class="sl-iwb__title-icon" aria-hidden="true">
                    <i class="ph ph-{{ block.settings.icon }}"></i>
                  </span>
                {% endif %}
                <h3 class="sl-iwb__title">{{ block.settings.title | escape }}</h3>
              </div>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="sl-iwb__desc rte">{{ block.settings.text }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {%- liquid
      # Homepage has no `product` in scope, so best-effort resolve the most
      # recently created product, then rotate to a non-main image (slot 2).
      # A merchant-set section image (s.image) always wins.
      assign featured_product = collections.all.products | sort: 'created_at' | last
      if featured_product == blank
        assign featured_product = collections.all.products.first
      endif
      assign iwb_image = s.image
      if iwb_image == blank
        assign iwb_image = featured_product.featured_image
        assign iwb_count = featured_product.images.size | default: 0
        if iwb_count > 0
          assign iwb_idx = 2 | modulo: iwb_count
          assign iwb_rot = featured_product.images[iwb_idx]
          if iwb_rot != blank
            assign iwb_image = iwb_rot
          endif
        endif
      endif
    -%}
    <div class="sl-iwb__media">
      {% if iwb_image != blank %}
        <img
          src="{{ iwb_image | image_url: width: 1600 }}"
          alt="{{ iwb_image.alt | default: s.heading | escape }}"
          width="{{ iwb_image.width }}"
          height="{{ iwb_image.height }}"
          loading="lazy"
        >
      {% endif %}
    </div>
  </div>
</div>



{%- if section.settings.sl_fade_up != false -%}
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');
  if(!root||root.dataset.slFadeBound)return;root.dataset.slFadeBound='1';
  var targets=root.querySelectorAll(':scope > .shopify-section, :scope > div, :scope > section');
  targets.forEach(function(t){t.classList.add('sl-fadeup');});
  if(!('IntersectionObserver' in window)){targets.forEach(function(t){t.classList.add('is-in');});return;}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
  targets.forEach(function(t){io.observe(t);});
})();
</script>
{%- endif -%}

