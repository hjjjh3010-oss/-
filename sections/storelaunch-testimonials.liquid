{% comment %}
  StoreLaunch — Testimonials Carousel
  Decoupled from Splide entirely: native CSS scroll-snap carousel.
  No splide.js / splide.css asset dependency, no hardcoded #splide ID
  (the original broke if two instances were on one page). No theme classes.
  Fully scoped + self-contained. Works on any theme.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Assistant:wght@400;600;700&display=swap">

{%- style -%}
  #shopify-section-{{ section.id }} .sl-fadeup{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1);will-change:opacity,transform;}
  #shopify-section-{{ section.id }} .sl-fadeup.is-in{opacity:1;transform:none;}
  @media (prefers-reduced-motion: reduce){#shopify-section-{{ section.id }} .sl-fadeup{opacity:1!important;transform:none!important;transition:none!important;}}

  {{ section.settings.sl_mt_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }}, #shopify-section-{{ section.id }} * { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }} !important; }
  #shopify-section-{{ section.id }} .sl-tst {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  #shopify-section-{{ section.id }} .sl-tst__inner { max-width: {{ section.settings.page_width }}px; margin: 0 auto; padding: 0 1.5rem; }
  #shopify-section-{{ section.id }} .sl-tst__title {
    margin: 0 0 1.8rem; color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.heading_align }};
    font-size: {{ section.settings.title_fs }}px; line-height: 1.2; font-weight: 700;
  }
  #shopify-section-{{ section.id }} .sl-tst__track {
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch; padding-bottom: 8px; scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .sl-tst__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .sl-tst__card {
    scroll-snap-align: center; flex: 0 0 calc((100% - 32px) / 3); min-width: 260px;
    background: {{ section.settings.card_bg }}; border-radius: 16px; padding: 24px;
    border: 1px solid {{ section.settings.heading_color | color_modify: 'alpha', 0.10 }};
    box-sizing: border-box; text-align: center;
  }
  #shopify-section-{{ section.id }} .sl-tst__stars { color: var(--sl-accent, {{ section.settings.star_color }}); font-size: {{ section.settings.stars_fs }}px; letter-spacing: 2px; margin: 0 0 .8rem; }
  #shopify-section-{{ section.id }} .sl-tst__card h3 { margin: 0 0 .6rem; color: {{ section.settings.heading_color }}; font-size: {{ section.settings.card_title_fs }}px; }
  #shopify-section-{{ section.id }} .sl-tst__card .sl-tst__quote { color: {{ section.settings.text_color }}; opacity: 0.85; font-size: {{ section.settings.quote_fs }}px; line-height: 1.6; }
  #shopify-section-{{ section.id }} .sl-tst__card .sl-tst__quote p { margin: 0; }
  #shopify-section-{{ section.id }} .sl-tst__author { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 1.2rem; }
  #shopify-section-{{ section.id }} .sl-tst__avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  #shopify-section-{{ section.id }} .sl-tst__name { font-weight: 600; font-size: {{ section.settings.name_fs }}px; color: {{ section.settings.heading_color }}; }
  @media (max-width: 999px) { #shopify-section-{{ section.id }} .sl-tst__card { flex: 0 0 calc((100% - 16px) / 2); } }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-tst__inner { padding: 0 1rem; }
    #shopify-section-{{ section.id }} .sl-tst__title { font-size: {{ section.settings.title_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-tst__stars { font-size: {{ section.settings.stars_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-tst__card h3 { font-size: {{ section.settings.card_title_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-tst__card .sl-tst__quote { font-size: {{ section.settings.quote_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-tst__name { font-size: {{ section.settings.name_fs_m }}px; }
  }
  @media (max-width: 567px)  { #shopify-section-{{ section.id }} .sl-tst__card { flex: 0 0 88%; } }
{%- endstyle -%}

<div class="sl-tst">
  <div class="sl-tst__inner">
    {% if section.settings.title != blank %}
      <h2 class="sl-tst__title">{{ section.settings.title }}</h2>
    {% endif %}
    <div class="sl-tst__track" role="list">
      {% for block in section.blocks %}
        <div class="sl-tst__card" role="listitem" {{ block.shopify_attributes }}>
          <p class="sl-tst__stars" aria-label="5 out of 5 stars">★★★★★</p>
          {% if block.settings.rev_title != blank %}<h3>{{ block.settings.rev_title }}</h3>{% endif %}
          <div class="sl-tst__quote">{{ block.settings.rev_description }}</div>
          <div class="sl-tst__author">
            {% if block.settings.author_image != blank %}
              <img class="sl-tst__avatar" src="{{ block.settings.author_image | image_url: width: 100 }}" alt="{{ block.settings.author | escape }}" width="40" height="40" loading="lazy">
            {% endif %}
            <span class="sl-tst__name">{{ block.settings.author }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{%- if section.settings.sl_fade_up != false -%}
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');
  if(!root||root.dataset.slFadeBound)return;root.dataset.slFadeBound='1';
  var targets=root.querySelectorAll(':scope > .shopify-section, :scope > div, :scope > section');
  targets.forEach(function(t){t.classList.add('sl-fadeup');});
  if(!('IntersectionObserver' in window)){targets.forEach(function(t){t.classList.add('is-in');});return;}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
  targets.forEach(function(t){io.observe(t);});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SL Testimonials",
  "tag": "section",
  "class": "sl-testimonials",
  "settings": [
    {
      "type": "font_picker",
      "id": "sl_mt_font",
      "label": "Font family",
      "default": "montserrat_n4"
    },
    {
      "type": "checkbox",
      "id": "sl_fade_up",
      "label": "Entrance animation (fade up on scroll)",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "What Customers Say"
    },
    {
      "type": "select",
      "id": "heading_align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Heading alignment"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "default": 1200,
      "unit": "px",
      "label": "Max width"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#ffd700"
    },
    {
      "type": "header",
      "content": "Font Sizes"
    },
    { "type": "range", "id": "title_fs", "min": 16, "max": 56, "step": 1, "unit": "px", "label": "Heading size (desktop)", "default": 30 },
    { "type": "range", "id": "title_fs_m", "min": 14, "max": 44, "step": 1, "unit": "px", "label": "Heading size (mobile)", "default": 24 },
    { "type": "range", "id": "stars_fs", "min": 10, "max": 32, "step": 1, "unit": "px", "label": "Stars size (desktop)", "default": 18 },
    { "type": "range", "id": "stars_fs_m", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "Stars size (mobile)", "default": 16 },
    { "type": "range", "id": "card_title_fs", "min": 12, "max": 32, "step": 1, "unit": "px", "label": "Review title size (desktop)", "default": 17 },
    { "type": "range", "id": "card_title_fs_m", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "Review title size (mobile)", "default": 16 },
    { "type": "range", "id": "quote_fs", "min": 11, "max": 24, "step": 1, "unit": "px", "label": "Review text size (desktop)", "default": 14 },
    { "type": "range", "id": "quote_fs_m", "min": 11, "max": 22, "step": 1, "unit": "px", "label": "Review text size (mobile)", "default": 14 },
    { "type": "range", "id": "name_fs", "min": 11, "max": 24, "step": 1, "unit": "px", "label": "Author name size (desktop)", "default": 14 },
    { "type": "range", "id": "name_fs_m", "min": 11, "max": 22, "step": 1, "unit": "px", "label": "Author name size (mobile)", "default": 14 },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "rev_title",
          "label": "Review title",
          "default": "Amazing product"
        },
        {
          "type": "richtext",
          "id": "rev_description",
          "label": "Review text",
          "default": "<p>This exceeded my expectations. Highly recommend!</p>"
        },
        {
          "type": "inline_richtext",
          "id": "author",
          "label": "Author name",
          "default": "Jane D."
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SL Testimonials",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
