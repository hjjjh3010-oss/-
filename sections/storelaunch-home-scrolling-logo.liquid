{%- liquid
  assign s = section.settings
  assign sl_skip_install_mask = false
  if request.design_mode
    assign sl_skip_install_mask = true
  endif
  if theme.role == 'development'
    assign sl_skip_install_mask = true
  endif
  assign logo_count = section.blocks.size
  if logo_count < 1
    assign logo_count = 1
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .sl-fadeup{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1);will-change:opacity,transform;}
  #shopify-section-{{ section.id }} .sl-fadeup.is-in{opacity:1;transform:none;}
  @media (prefers-reduced-motion: reduce){#shopify-section-{{ section.id }} .sl-fadeup{opacity:1!important;transform:none!important;transition:none!important;}}

  {{ section.settings.sl_mt_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }}, #shopify-section-{{ section.id }} * { font-family: {{ section.settings.sl_mt_font.family }}, {{ section.settings.sl_mt_font.fallback_families }} !important; }
  #shopify-section-{{ section.id }}.storelaunch-home-scrolling-logo {
    --sl-bg: #ffffff;
    --sl-text: {{ s.text_color }};
    --sl-muted: {{ s.muted_text_color }};
    --sl-gap: {{ s.logo_gap }}px;
    --sl-logo-height: {{ s.logo_height }}px;
    --sl-duration: {{ s.scroll_speed }}s;
    --sl-mobile-align: {{ s.mobile_text_align | default: 'left' }};
    background: var(--sl-bg);
    color: var(--sl-text);
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }}.storelaunch-home-scrolling-logo {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .sl-sl__wrap {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
    box-sizing: border-box;
    display: grid;
    gap: clamp(16px, 2.5vw, 28px);
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .sl-sl__wrap {
      grid-template-columns: minmax(210px, 280px) minmax(0, 1fr);
      gap: clamp(20px, 3vw, 42px);
    }
  }

  #shopify-section-{{ section.id }} .sl-sl__intro {
    max-width: 280px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .sl-sl__intro {
      width: 100%;
      max-width: none;
      text-align: var(--sl-mobile-align);
    }

    #shopify-section-{{ section.id }} .sl-sl__heading,
    #shopify-section-{{ section.id }} .sl-sl__sub {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .sl-sl__wrap[data-mobile-align='center'] .sl-sl__intro {
      justify-self: center;
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .sl-sl__wrap[data-mobile-align='right'] .sl-sl__intro {
      justify-self: end;
      margin-left: auto;
      margin-right: 0;
    }
  }

  #shopify-section-{{ section.id }} .sl-sl__heading {
    margin: 0 0 8px;
    font-size: {{ s.heading_fs }}px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .sl-sl__sub {
    margin: 0;
    color: var(--sl-muted);
    font-size: {{ s.subheading_fs }}px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .sl-sl__rail {
    min-width: 0;
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%);
  }

  #shopify-section-{{ section.id }} .sl-sl__track {
    display: flex;
    width: max-content;
    gap: var(--sl-gap);
    animation: sl-scroll-logos-{{ section.id }} var(--sl-duration) linear infinite;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .sl-sl__group {
    display: flex;
    align-items: center;
    gap: var(--sl-gap);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .sl-sl__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(130px, 15vw, 200px);
    min-height: calc(var(--sl-logo-height) + 10px);
    opacity: 0.98;
  }

  #shopify-section-{{ section.id }} .sl-sl__item img {
    width: auto;
    height: auto;
    max-width: min(220px, 22vw);
    max-height: var(--sl-logo-height);
    object-fit: contain;
    display: block;
    filter: grayscale(1) contrast(1.1);
  }

  #shopify-section-{{ section.id }} .sl-sl__fallback-logo {
    margin: 0;
    font-size: {{ s.logo_text_fs }}px;
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .sl-sl__wrap { padding: 0 1rem; }
    #shopify-section-{{ section.id }} .sl-sl__heading { font-size: {{ s.heading_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-sl__sub { font-size: {{ s.subheading_fs_m }}px; }
    #shopify-section-{{ section.id }} .sl-sl__fallback-logo { font-size: {{ s.logo_text_fs_m }}px; }
  }

  @keyframes sl-scroll-logos-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - (var(--sl-gap) / 2)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .sl-sl__track {
      animation: none;
    }
  }
{%- endstyle -%}



<section class="sl-sl__wrap" data-mobile-align="{{ s.mobile_text_align | default: 'left' }}">
  <div class="sl-sl__intro">
    {% if s.heading != blank %}
      <h2 class="sl-sl__heading">{{ s.heading | escape }}</h2>
    {% endif %}
    {% if s.subheading != blank %}
      <p class="sl-sl__sub">{{ s.subheading | escape | newline_to_br }}</p>
    {% endif %}
  </div>

  <div class="sl-sl__rail" aria-label="Scrolling publication logos">
    <div class="sl-sl__track" role="presentation">
      <div class="sl-sl__group">
        {% for block in section.blocks %}
          <div class="sl-sl__item" {{ block.shopify_attributes }}>
            {% if block.settings.logo_image != blank %}
              <img
                src="{{ block.settings.logo_image | image_url: width: 500 }}"
                alt="{{ block.settings.logo_alt | default: block.settings.logo_text | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_image.width }}"
                height="{{ block.settings.logo_image.height }}"
              >
            {% elsif block.settings.logo_text != blank %}
              <p class="sl-sl__fallback-logo">{{ block.settings.logo_text | escape }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="sl-sl__group" aria-hidden="true">
        {% for block in section.blocks %}
          <div class="sl-sl__item">
            {% if block.settings.logo_image != blank %}
              <img
                src="{{ block.settings.logo_image | image_url: width: 500 }}"
                alt=""
                loading="lazy"
                width="{{ block.settings.logo_image.width }}"
                height="{{ block.settings.logo_image.height }}"
              >
            {% elsif block.settings.logo_text != blank %}
              <p class="sl-sl__fallback-logo">{{ block.settings.logo_text | escape }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>



{%- if section.settings.sl_fade_up != false -%}
<script>
(function(){
  var root=document.getElementById('shopify-section-{{ section.id }}');
  if(!root||root.dataset.slFadeBound)return;root.dataset.slFadeBound='1';
  var targets=root.querySelectorAll(':scope > .shopify-section, :scope > div, :scope > section');
  targets.forEach(function(t){t.classList.add('sl-fadeup');});
  if(!('IntersectionObserver' in window)){targets.forEach(function(t){t.classList.add('is-in');});return;}
  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target);}});},{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
  targets.forEach(function(t){io.observe(t);});
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling Logos",
  "tag": "section",
  "class": "storelaunch-home-scrolling-logo",
  "max_blocks": 12,
  "settings": [
    {
      "type": "font_picker",
      "id": "sl_mt_font",
      "label": "Font family",
      "default": "montserrat_n4"
    },
    {
      "type": "checkbox",
      "id": "sl_fade_up",
      "label": "Entrance animation (fade up on scroll)",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 1200
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In The Press"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Celebrated by leading publications around the globe."
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "label": "Mobile heading & subheading alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Logo max height",
      "default": 52
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 12,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Gap between logos",
      "default": 42
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 12,
      "max": 90,
      "step": 1,
      "unit": "s",
      "label": "Scroll duration",
      "default": 36
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Subheading color",
      "default": "#4b5563"
    },
    {
      "type": "header",
      "content": "Font Sizes"
    },
    { "type": "range", "id": "heading_fs", "min": 18, "max": 64, "step": 1, "unit": "px", "label": "Heading size (desktop)", "default": 38 },
    { "type": "range", "id": "heading_fs_m", "min": 16, "max": 52, "step": 1, "unit": "px", "label": "Heading size (mobile)", "default": 26 },
    { "type": "range", "id": "subheading_fs", "min": 10, "max": 28, "step": 1, "unit": "px", "label": "Subheading size (desktop)", "default": 16 },
    { "type": "range", "id": "subheading_fs_m", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Subheading size (mobile)", "default": 14 },
    { "type": "range", "id": "logo_text_fs", "min": 16, "max": 64, "step": 1, "unit": "px", "label": "Fallback logo text size (desktop)", "default": 38 },
    { "type": "range", "id": "logo_text_fs_m", "min": 14, "max": 52, "step": 1, "unit": "px", "label": "Fallback logo text size (mobile)", "default": 26 },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Image alt text",
          "default": "Publication logo"
        },
        {
          "type": "text",
          "id": "logo_text",
          "label": "Fallback text",
          "default": "VOGUE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling Logos",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "logo_text": "VOGUE",
            "logo_alt": "Vogue logo"
          }
        },
        {
          "type": "logo",
          "settings": {
            "logo_text": "Forbes",
            "logo_alt": "Forbes logo"
          }
        },
        {
          "type": "logo",
          "settings": {
            "logo_text": "Women's Health",
            "logo_alt": "Women's Health logo"
          }
        },
        {
          "type": "logo",
          "settings": {
            "logo_text": "ELLE",
            "logo_alt": "Elle logo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
