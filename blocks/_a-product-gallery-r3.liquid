      "default": true,
      "info": "Show previous/next buttons on Gallery images",
      "visible_if": "{{ block.settings.gallery_layout == 'thumbnail_slider' }}"  
    },
    {
      "type": "checkbox",
      "id": "show_button_navigation_mobile",
      "label": "Show button navigation mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "nav_button_size",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Button size",
      "default": 41,
      "visible_if": "{{ block.settings.gallery_layout == 'thumbnail_slider' }}"
    },
    {
      "type": "color",
      "id": "nav_button_bg_color",
      "label": "Button background color",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.gallery_layout == 'thumbnail_slider' }}"
    },
    {
      "type": "color",
      "id": "nav_button_hover_bg_color",
      "label": "Button hover background color",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.gallery_layout == 'thumbnail_slider' }}"
    },
    {
      "type": "color",
      "id": "nav_button_border_color",
      "label": "Button border color",
      "default": "#C9C9C9",
      "visible_if": "{{ block.settings.gallery_layout == 'thumbnail_slider' }}"
    },
    {
      "type": "color",
      "id": "nav_button_hover_border_color",
      "label": "Button hover border color",
      "default": "#999999",
      "visible_if": "{{ block.settings.gallery_layout == 'thumbnail_slider' }}"
    },
    {
      "type": "color",
      "id": "nav_button_icon_color",
      "label": "Button icon color",
      "default": "#000000",
      "visible_if": "{{ block.settings.gallery_layout == 'thumbnail_slider' }}"
    },
    {
      "type": "color",
      "id": "nav_button_hover_icon_color",
      "label": "Button hover icon color",
      "default": "#333333",
