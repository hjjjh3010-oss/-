          "label": "Thumbnail carousel"
        }
      ],
      "default": "thumbnail_slider",
      "label": "Gallery layout"
    },
    {
      "type": "checkbox",
      "id": "desktop_thumbnails_left",
      "default": false,
      "label": "Desktop: thumbnails on left",
      "info": "Places the gallery thumbnails as a vertical column to the left of the main media (desktop only)."
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "Desktop sticky gallery"
    },
    {
      "type": "select",
      "id": "image_zoom",
      "options": [
        {
          "value": "lightbox",
          "label": "Open lightbox"
        },
        {
          "value": "none",
          "label": "No zoom"
        }
      ],
      "default": "lightbox",
      "label": "Image zoom"
    },
    {
      "type": "checkbox",
      "id": "full_width_gallery_mobile",
      "label": "Mobile: Full width gallery",
      "default": false
    },
    {
      "type": "select",
      "id": "media_size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "small",
      "label": "Desktop media width",
      "info": "Media is automatically optimized for mobile."
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "options": [
        {
          "value": "show",
          "label": "Show"
        },
        {
          "value": "hide",
          "label": "Hide"
        }
      ],
      "default": "hide",
      "label": "Mobile thumbnails"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "default": false,
      "label": "Video looping"
    },
    {
      "type": "header",
      "content": "Gallery Navigation Buttons",
      "visible_if": "{{ block.settings.gallery_layout == 'thumbnail_slider' }}"
    },
    {
