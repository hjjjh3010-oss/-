{% assign product = closest.product %}
{% assign collapsible_id = block.id | append: '-' | append: section.id %}
{% assign collapsible_title = block.settings.heading | default: block.settings.page.title %}
<div class="product-block-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- render 'a-collapsible-r4',
    id: collapsible_id,
    title: collapsible_title,
    row_title_color: block.settings.coll_heading_color,
    row_title_highlighted_color: block.settings.coll_heading_highlighted_color,
    text_content: block.settings.content,
    row_text_content_color: block.settings.coll_text_color,
    row_text_content_highlighted_color: block.settings.coll_text_highlighted_color,
    collapsible_font_size: block.settings.collapsible_font_size,
    collapsible_font_heading_size: block.settings.collapsible_font_heading_size,
    border_radius: block.settings.collapsible_border_radius,
    padding_top: block.settings.padding_top,
    padding_bottom: block.settings.padding_bottom,
    border_bottom_width: block.settings.border_bottom_width,
    border_bottom_color: block.settings.border_bottom_color,
    button_label: block.settings.button_label,
    button_url: block.settings.button_url,
    button_text_color: block.settings.button_text_color,
    button_background_color: block.settings.button_background_color,
    button_border_color: block.settings.button_border_color
  -%}
</div>

{% schema %}
{
  "name": "Dropdown row",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Description",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Optional. Adds a link inside the open row — e.g. pointing at a fuller section further down the page. Leave empty for no button."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "collapsible_font_heading_size",
      "label": "Heading font size",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "collapsible_font_size",
      "label": "Body font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "coll_heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "coll_heading_highlighted_color",
      "label": "Bolded heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "coll_text_color",
      "label": "Body color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "coll_text_highlighted_color",
      "label": "Bolded body color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "collapsible_border_radius",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 20
    },
    {
      "type": "header",
      "content": "Row spacing & divider"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Row top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Row bottom padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_bottom_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Divider (border bottom) width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_bottom_color",
      "label": "Divider (border bottom) color"
    }
  ],
  "presets": [
    {
      "name": "Collapsible Tab",
      "category": "Product Information"
    }
  ]
}
{% endschema %}
