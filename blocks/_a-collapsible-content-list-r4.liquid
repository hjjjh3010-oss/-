
<style>
    {% if request.visual_preview_mode %}
      {% assign section_id_variable = 'id' %}
    {% else %}
      {% assign section_id_variable = section.id %}
    {% endif %}
    .atlas-isolation-wrapper .singleAccordianContainer-{{ section_id_variable }} {
      {% if block.settings.rows_have_border %}
        border-bottom: {{ block.settings.rows_border_width }}px solid rgba({{ block.settings.rows_border_color.red }}, {{ block.settings.rows_border_color.green }}, {{ block.settings.rows_border_color.blue }}, {{ block.settings.rows_border_color_opacity | divided_by: 100.0 }});
        {%- comment -%}
          Gated (default off). `row_container_bg_color_scheme` is INERT whenever rows
          have borders — it only ever applied in the else branch — so a design that
          wants one filled panel divided by hairlines cannot say so. It cannot simply
          be hoisted: the setting defaults to #F9F9F9, so unconditional application
          would paint a grey fill onto every bordered accordion in the library.
        {%- endcomment -%}
        {% if block.settings.fill_rows_with_borders %}
          background-color: {{ block.settings.row_container_bg_color_scheme }};
        {% endif %}
      {% else %}
        background-color: {{ block.settings.row_container_bg_color_scheme }};
        border-radius: {{ block.settings.border_radius }}px;
      {% endif %}
  }
  {% if block.settings.rows_have_border and block.settings.hide_first_row_border != true %}
    .atlas-isolation-wrapper .singleAccordianContainer-{{ section_id_variable }}:first-of-type {
        border-top: {{ block.settings.rows_border_width }}px solid rgba({{ block.settings.rows_border_color.red }}, {{ block.settings.rows_border_color.green }}, {{ block.settings.rows_border_color.blue }}, {{ block.settings.rows_border_color_opacity | divided_by: 100.0 }});
    }
  {% endif %}

  .atlas-isolation-wrapper .accordionButtonStyle-{{ section_id_variable }} {
    border: none;
    display: block;
    background-color: transparent;
    color: #444;
    cursor: pointer;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    width: 100%;
    text-align: left;
    outline: none;
    transition: 0.1s;
    cursor: pointer;
    -ms-touch-action: manipulation;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .atlas-isolation-wrapper .allAccordionButtonsContainer-{{ section_id_variable }} {
    display: flex;
    flex-direction: column;
    {% if block.settings.rows_have_border == false%}
      gap: {{  block.settings.row_gap }}px;
    {% endif %}
    {%- comment -%}
      Optional card around the whole list, for designs that present the rows as one
      panel divided by hairlines rather than as bare rows on the section background.
      Each property gates on its own value — blank colours and 0 lengths emit nothing —
      so every existing accordion in the library is untouched. The radius also clips,
      otherwise the last row's divider would cut across the rounded bottom corners.
    {%- endcomment -%}
    {%- if block.settings.container_background_color != blank %}
      background: {{ block.settings.container_background_color }};
    {%- endif %}
    {%- if block.settings.container_border_color != blank %}
      border: 1px solid {{ block.settings.container_border_color }};
    {%- endif %}
    {%- if block.settings.container_border_radius > 0 %}
      border-radius: {{ block.settings.container_border_radius }}px;
      overflow: hidden;
    {%- endif %}
    {%- if block.settings.container_horizontal_padding > 0 %}
      padding-left: {{ block.settings.container_horizontal_padding }}px;
      padding-right: {{ block.settings.container_horizontal_padding }}px;
    {%- endif %}
  }
  {%- comment -%}
    A card inset that reads well on desktop eats a phone's line length — 32px each side
    of a 335px card leaves a two-line question almost touching the toggle. 0 means
    "follow the desktop value" rather than "no padding", so a template that sets only
    the desktop key keeps the padding it asked for at every width.
  {%- endcomment -%}
  {%- if block.settings.container_horizontal_padding_mobile > 0 %}
    @media screen and (max-width: 768px) {
      .atlas-isolation-wrapper .allAccordionButtonsContainer-{{ section_id_variable }} {
        padding-left: {{ block.settings.container_horizontal_padding_mobile }}px;
        padding-right: {{ block.settings.container_horizontal_padding_mobile }}px;
      }
    }
  {%- endif %}
  {%- comment -%}
    A card's own border already closes the list, so the final row's divider would read as
    a stray line just above it. Mirrors `hide_first_row_border`, and defaults off.
  {%- endcomment -%}
  {%- if block.settings.rows_have_border and block.settings.hide_last_row_border %}
    .atlas-isolation-wrapper .singleAccordianContainer-{{ section_id_variable }}:last-of-type {
      border-bottom: 0;
    }
  {%- endif %}
  .atlas-isolation-wrapper .panelStyle-{{ section_id_variable }} p {
    line-height: 1.4em;
      margin-top: 0px;
      margin-bottom: {{ block.settings.vertical_padding }}px !important;
  }

  {% if block.settings.title_row_has_underline_on_hover %}
    .atlas-isolation-wrapper .accordionButtonStyle-{{ section_id_variable }}:hover .collapsibleTitleSpan-{{ section_id_variable }} {
      text-decoration: underline;
    }
  {% endif %}
  .atlas-isolation-wrapper .accordionButtonStyle-{{ section_id_variable }} .index-number {
    font-size: {{ block.settings.index_number_size | divided_by: 2 }}px;
    color: {{ block.settings.index_number_color }};
    width: {{ block.settings.index_number_size }}px;
    height: {{ block.settings.index_number_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.index_number_background_color }};
    border-radius: 50%;
    flex-shrink: 0;
    line-height: 100%;
  }

  .atlas-isolation-wrapper .panelStyle-{{ section_id_variable }} {
    padding: 0 {{ block.settings.horizontal_padding }}px;
    {%- comment -%}
      The extra left padding lines the answer up under the question text when a row
      number sits to its left: number width plus the 14px gap between number and title.
      It only makes sense when the number is actually rendered, and the row block draws
      it under `section.settings.show_index` — so the offset is gated on the same flag.
      Unconditionally, a template with the number off still reserved the gap, and the
      answer sat 14px (plus any configured number size) right of its own question.
    {%- endcomment -%}
    {%- if section.settings.show_index -%}
      padding-left: calc({{ block.settings.horizontal_padding }}px + {{ block.settings.index_number_size }}px + 14px);
    {%- endif -%}
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-in-out;
  }
  .atlas-isolation-wrapper .icon-minus-{{ section_id_variable }},
  .atlas-isolation-wrapper .icon-plus-{{ section_id_variable }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }
  .atlas-isolation-wrapper .icon-minus-{{ section_id_variable }} path,
  .atlas-isolation-wrapper .icon-plus-{{ section_id_variable }} path {
    fill: {{ block.settings.icon_color }};
  }
  .atlas-isolation-wrapper .allAccordionButtonsContainer-{{ section_id_variable }} .collapsibleTitleSpan-{{ section_id_variable }} {
    font-size: {{ block.settings.heading_font_size }}px;
    letter-spacing: calc(var(--atlas-font-heading-scale) * 0.6px);
  }
  @media (max-width: 768px) {
    .atlas-isolation-wrapper .allAccordionButtonsContainer-{{ section_id_variable }} .collapsibleTitleSpan-{{ section_id_variable }} {
      font-size: {{ block.settings.heading_font_size_mobile }}px;
    }
  }
  .atlas-isolation-wrapper .allAccordionButtonsContainer-{{ section_id_variable }} .panelStyle-{{ section_id_variable }} p {
    font-size: {{ block.settings.body_font_size }}px;
  }
  @media (max-width: 768px) {
    .atlas-isolation-wrapper .allAccordionButtonsContainer-{{ section_id_variable }} .panelStyle-{{ section_id_variable }} p {
      font-size: {{ block.settings.body_font_size_mobile }}px;
    }
  }
</style>
{% capture rows %}
  {% content_for 'blocks' %}
{% endcapture %}
{% assign rows = rows | split: '<!-- end block -->' %}

<div class="allAccordionButtonsContainer-{{ section_id_variable }} fade-in-child" {{ block.shopify_attributes }}>
 {% for row in rows %} 
    {% if row contains '<!--@#$%-->' %}
      {% assign row_new = row | replace: '<!--@#$%-->', forloop.index  %}
      {{ row_new }}
    {% else %}
      {{ row }}
    {% endif %}
 {% endfor %}
</div>
{% schema %}
{
  "name": "Collapsible content list",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Desktop heading font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Mobile heading font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Desktop body font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_font_size_mobile",
      "label": "Mobile body font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "index_number_size",
      "label": "Row number size",
      "min": 0,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "color",
      "id": "index_number_color",
      "label": "Row number text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "index_number_background_color",
      "label": "Row number background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "rows_have_border",
      "label": "Use separator lines between rows",
      "default": false,
      "info": "If enabled, rows will have separator lines instead of background colors"
    },
    {
      "type": "checkbox",
      "id": "hide_last_row_border",
      "label": "Hide last row border",
      "default": false
    },
    {
      "type": "color",
      "id": "container_background_color",
      "label": "List card background",
      "info": "Leave empty for no card background."
    },
    {
      "type": "color",
      "id": "container_border_color",
      "label": "List card border color",
      "info": "Leave empty for no card border."
    },
    {
      "type": "range",
      "id": "container_border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "List card corner radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "container_horizontal_padding_mobile",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "List card horizontal padding (mobile)",
      "info": "0 follows the desktop value.",
      "default": 0
    },
    {
      "type": "range",
      "id": "container_horizontal_padding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "List card horizontal padding",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_first_row_border",
      "label": "Hide top separator on first row",
      "default": false,
      "info": "Removes the separator line above the first row (bottom-only dividers).",
      "visible_if": "{{ block.settings.rows_have_border }}"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15,
      "visible_if": "{{ block.settings.rows_have_border  == false}}" 
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Row border radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ block.settings.rows_have_border  == false}}" 
    },
    {
      "type": "checkbox",
      "id": "fill_rows_with_borders",
      "label": "Fill rows when they have borders",
      "default": false,
      "info": "Paints the row background even with borders on, so the list reads as one panel divided by hairlines.",
      "visible_if": "{{ block.settings.rows_have_border }}"
    },
    {
      "type": "color",
      "id": "row_container_bg_color_scheme",  
      "default": "#F9F9F9",
      "label": "Row background color",
      "visible_if": "{{ block.settings.rows_have_border  == false}}"
    },
    {
      "type": "color",
      "id": "rows_border_color",
      "label": "Separator line color",
      "default": "#000000",
      "visible_if": "{{ block.settings.rows_have_border  == true}}"
    },
    {
      "type": "range",
      "id": "rows_border_color_opacity",
      "label": "Separator line opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 15,
      "visible_if": "{{ block.settings.rows_have_border  == true}}"
    },
    {
      "type": "range",
      "id": "rows_border_width",
      "label": "Separator line width",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.rows_have_border  == true}}"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Row vertical padding",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Row horizontal padding",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#181818"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "title_row_has_underline_on_hover",
      "label": "Show underline on hover",
      "default": false,
      "info": "Adds underline effect when hovering over row titles"
    }
  ],
  "blocks": [
    {
      "type": "_a-collapsible-content-row"
    }
  ],
  "presets": [
