{% comment %} SEO Meta Tags {% endcomment %}
<meta name="description" content="{{ page_description | default: shop.description | escape }}">
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
<meta property="og:description" content="{{ page_description | default: shop.description | escape }}">
<meta property="og:type" content="website">
{% if page_image %}
  <meta property="og:image" content="{{ page_image | img_url: width: 1200 }}">
{% elsif settings.social_share_image %}
  <meta property="og:image" content="{{ settings.social_share_image | img_url: width: 1200 }}">
{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="{{ settings.social_twitter_handle | default: '' }}">
<meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
<meta name="twitter:description" content="{{ page_description | default: shop.description | escape }}">
{% if page_image %}
  <meta name="twitter:image" content="{{ page_image | img_url: width: 1200 }}">
{% endif %}